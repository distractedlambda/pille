#lang pille/testsuite

//==============================================================================
struct NegateOnAssign:
  value :: Int(32)

method (inout dst :: NegateOnAssign).$assign(src :: NegateOnAssign):
  dst.value := -src.value

test:
  var noa = NegateOnAssign{0}
  noa := NegateOnAssign{42}
  assert(noa.value == -42)

//==============================================================================
struct Pair(α, β):
  first :: α
  second :: β

fun make_pair(first :: α, second :: β):
  Pair(α, β){first, second}

test:
  var p = make_pair(0 :: Int(32), NegateOnAssign{0})
  p := make_pair(42 :: Int(32), NegateOnAssign{42})
  assert(p.first == 42)
  assert(p.second.value == -42)
