#lang pille/testsuite

test:
  assert(5 ∈ 4..7)
  assert((5 :: Int(32)) ∈ 4..7)
  assert((5 :: Int(32)) ∈ 4..(7 :: Int(17)))
  assert((5 :: Int(32)) ∈ (4 :: Int(8)) .. (7 :: Int(17)))
  assert((5 :: Int(32)) ∉ (4 :: Int(8)) .. (5 :: Int(17)))

test:
  var sum :: Int(32) = 0
  for (i ∈ 1..10):
    sum := sum + i
  assert(sum == 45)

test:
  var sum :: Int(32) = 0
  for (i ∈ 15..99, j ∈ 1..10):
    sum := sum + j
  assert(sum == 45)

test:
  for (i ∈ 1..1):
    panic("shouldn't get here")

test:
  for (i ∈ (1 :: Int(32))..1):
    panic("shouldn't get here")
