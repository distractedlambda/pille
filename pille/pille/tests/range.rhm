#lang pille/testsuite

test:
  assert(5 ∈ 4..7)
  assert((5 :: Int(32)) ∈ 4..7)
  assert((5 :: Int(32)) ∈ 4..(7 :: Int(17)))
  assert((5 :: Int(32)) ∈ (4 :: Int(8)) .. (7 :: Int(17)))
  assert((5 :: Int(32)) ∉ (4 :: Int(8)) .. (5 :: Int(17)))

test:
  var sum :: Int(32) = 0
  for (i ∈ 1..10):
    sum := sum + i
  assert(sum == 45)

test:
  var sum :: Int(32) = 0
  for (i ∈ 15..99, j ∈ 1..10):
    sum := sum + j
  assert(sum == 45)

test:
  for (i ∈ 1..1):
    panic("shouldn't get here")

test:
  for (i ∈ (1 :: Int(32))..1):
    panic("shouldn't get here")

//==============================================================================
// Range types

test:
  let r = (1 :: Int(8)) .. (300 :: Int(16))
  assert(type_of(r) == Range(Int(16)))
  assert(r.start == 1)
  assert(r.end == 300)
  let from = (5 :: UInt(8))..
  assert(type_of(from) == RangeFrom(UInt(8)))
  let to = ..(5 :: UInt(8))
  assert(type_of(to) == RangeTo(UInt(8)))
  let full = ..
  assert(type_of(full) == RangeFull)

test:
  let x :: Int(32) = 5
  assert(x ∈ (5 :: Int(32))..)
  assert(x ∉ (6 :: Int(32))..)
  assert(x ∈ ..(6 :: Int(32)))
  assert(x ∉ ..(5 :: Int(32)))
  assert(x in 0..10)
  // A range includes its start but not its end.
  assert(x ∈ 5..6)
  assert(x ∉ 4..5)

test:
  ~when ub.checked
  ~expect_panic
  let lo :: Int(32) = 5
  let hi :: Int(32) = 4
  lo..hi
  #void

test:
  // An empty range is fine.
  let lo :: Int(32) = 5
  lo..lo
  #void

test:
  var count :: Int(32) = 0
  for (i ∈ (250 :: UInt(8))..(255 :: UInt(8))):
    count := count + 1
  assert(count == 5)

test:
  var sum :: Int(32) = 0
  for (i ∈ (-3 :: Int(32))..3):
    sum := sum + i
  assert(sum == -3)

test:
  // Iterating stops at the end of the shortest sequence.
  var count :: Int(32) = 0
  for (i ∈ 0..100, j ∈ 0..3, k ∈ 0..50):
    count := count + 1
  assert(count == 3)

test:
  // The elements of a range of specialization integers have a runtime
  // integer type.
  for (i ∈ 0..3):
    specl.assert(type_of(i) == UInt(2))
  #void
