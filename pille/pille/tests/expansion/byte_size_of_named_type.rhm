#lang pille/testsuite

// `Double` names both a type and a namespace, so `Double.byte_size` is
// read as a lookup in the namespace and fails to expand. Writing
// `(Double).byte_size` works. This file is separate from struct.rhm so
// that the expansion error doesn't stop the tests there from running.
// It runs from expansion.rhm.

test:
  specl.assert(Double.byte_size == 8)
  specl.assert(Float.byte_size == 4)
