#lang pille/testsuite

// A test that fails concretization shouldn't affect the tests after it.
//
// Under the check policy, `Int(16).cast_exact` from a `UInt` doesn't
// concretize (integer.rhm has its own tests for that). These two tests
// are the same, and each one passes when it runs alone. But the second
// one fails with an internal error, "Map.get: no value found for key",
// instead of the concretization failure it expects.

test:
  ~when ub.checked
  ~expect_concr_fail
  let u :: UInt(32) = 255
  Int(16).cast_exact(u)

test:
  ~when ub.checked
  ~expect_concr_fail
  let u :: UInt(32) = 255
  Int(16).cast_exact(u)
