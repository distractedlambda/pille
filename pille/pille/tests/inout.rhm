#lang pille/testsuite

struct Point(α):
  x :: α
  y :: α

fun swap(inout fst :: α, inout snd :: α) :: Void:
  let tmp = fst
  fst := snd
  snd := tmp

method (inout pt :: Point(α)).form_transpose() :: Void:
  swap(pt.x, pt.y)

test:
  var pt = Point(Int(32)){1, 2}
  pt.form_transpose()
  assert(pt.y == 1)
