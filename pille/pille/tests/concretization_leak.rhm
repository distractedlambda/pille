#lang pille/testsuite

// A test that fails concretization shouldn't affect the tests after it.
//
// Each function here declares its result type, so a call to it is
// concretized right away, but its body is concretized only after the
// body of the test. Each body calls a method that doesn't exist, so
// concretizing it fails.

fun broken_a(x :: Int(8)) :: Int(8):
  x.not_a_method()

fun broken_b(x :: Int(8)) :: Int(8):
  x.not_a_method()

fun broken_c(x :: Int(8)) :: Int(8):
  x.not_a_method()

fun works(x :: Int(8)) :: Int(8):
  x + 1

test:
  // Both bodies fail. The second one shouldn't be left for a later test
  // to run.
  ~expect_concr_fail
  broken_a(1 :: Int(8)) + broken_b(2 :: Int(8))

test:
  assert(works(1 :: Int(8)) == 2)

test:
  // A second call to the same function fails the same way, instead of
  // referring to a function that was never defined.
  ~expect_concr_fail
  broken_a(1 :: Int(8))

test:
  ~expect_concr_fail
  broken_b(1 :: Int(8))

test:
  // The test body fails after the call to `broken_c` was concretized, so
  // its body hasn't been concretized yet. That shouldn't be left for a
  // later test either.
  ~expect_concr_fail
  let y = broken_c(1 :: Int(8))
  y.not_a_method()

test:
  assert(works(2 :: Int(8)) == 3)
