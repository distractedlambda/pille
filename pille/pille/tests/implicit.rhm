#lang pille/testsuite

implicit scale :: Specl(_ :: nat)

test:
  using scale = 2
  assert(scale == 2)

fun apply_scale(lhs, using scale):
  lhs * scale

test:
  using scale = 2
  assert(apply_scale(4) == 8)

fun apply_scale_twice(x, using scale):
  apply_scale(apply_scale(x))

test:
  using scale = 2
  assert(apply_scale_twice(4) == 16)

test:
  ~expect_concr_fail
  apply_scale_twice(4)

fun apply_scale_twice_transparent(x):
  ~transparent
  apply_scale(apply_scale(x))

test:
  using scale = 2
  assert(apply_scale_twice_transparent(4) == 16)

test:
  ~expect_concr_fail
  using scale :: Int(32) = 4
  #void
