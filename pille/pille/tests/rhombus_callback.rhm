#lang rhombus/static

import:
  pille/hosted open

pille.configure_jit(~ub_policy: #'check)

check:
  pille:
    rhombus :: UInt(32):
      42
  ~is 42

check:
  pille:
    rhombus(x = 4 :: UInt(32), y = 5 :: UInt(32)) :: UInt(32):
      x + y
  ~is 9

check:
  pille:
    rhombus:
      error("oh noes")
  ~throws "oh noes"

check:
  pille:
    panic()
    #void // TODO: support Never results here instead
  ~throws "panic"

check:
  pille(x :: Int(8) = 42, y :: Int(8) = 99):
    x + y
  ~throws "panic"
