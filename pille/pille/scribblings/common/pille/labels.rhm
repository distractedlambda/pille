#lang rhombus/static/and_meta

import:
  meta_label:
    only_meta 0:
        pille open

    only_meta 1:
        pille open:
          except:
            fun
            math
            namespace
            operator

    rhombus as rhm:
      expose:
        Srcloc // why need?

    rhombus/meta as rhm_meta

export:
  meta_label:
    all_from(pille)
    all_from(rhombus)
    rhm
    rhm_meta
