#lang rhombus/static/and_meta

import:
  rhombus/scribble/manual
  scribble/doc_meta open
  scribble/spacer
  meta:
    rhombus/rx open
    rhombus/static/meta open

meta:
  //============================================================================
  export syntax_class NameOrEsc(esc):
    kind: ~sequence
    fields: «»
  | '$(esc_name :: Name)($_)':
      match_when syntax_meta.equal_binding(esc_name, esc)
  | '$(_ :: Name)'

  //============================================================================
  export syntax_class NonemptySequence:
    kind: ~sequence
  | '$_ $_ ...'

  //============================================================================
  export syntax_class MaybeBlock:
    kind: ~sequence
  | ': $_'
  | ''

  //============================================================================
  export syntax_class Option:
    kind: ~group
  | '$(_ :: Keyword) $_ ...'

  //============================================================================
  export syntax_class BlockOrAlt:
    kind: ~term
  | ': $_'
  | '| $_ | ...'

  export syntax_class SimpleTerm:
    kind: ~term
    fields: «»
  | '$term':
      match_when term !matches '$(_ :: BlockOrAlt)'

  export syntax_class SimpleSequence:
    kind: ~sequence
  | '$(_ :: SimpleTerm) ...'

  export syntax_class SimpleNonemptySequence:
    kind: ~sequence
  | '$(_ :: SimpleTerm) $(_ :: SimpleSequence)'

  //============================================================================
  export syntax_class ResAnnot:
    kind: ~sequence
    fields: op annot
  | '$('::' && op) $(annot :: SimpleNonemptySequence)'

  export syntax_class MaybeResAnnot:
    kind: ~sequence
    fields:
      op :~ maybe(Operator)
      annot :~ maybe(Group)
      present :~ Boolean
  | '$(_ :: ResAnnot: open)':
      field present = #true
  | '':
      field op = #false
      field annot = #false
      field present = #false

  export fun adjust_res_annot(stx, esc):
    spacer.adjust_group(stx, expr_ctx, esc)

  export fun adjust_specl_res_annot(stx, esc):
    spacer.adjust_group(stx, specl_expr_ctx, esc)

  export fun adjust_maybe_res_annot(stx, esc):
    match stx
    | '': stx
    | _: adjust_res_annot(stx, esc)

  export fun adjust_maybe_specl_res_annot(stx, esc):
    match stx
    | '' : stx
    | _: adjust_specl_res_annot(stx, esc)

  //============================================================================
  export syntax_class MemberName:
    kind: ~sequence
  | '$('$') $(_ :: Identifier)'
  | '$(_ :: Identifier)'

  export syntax_class DotMemberName:
    kind: ~sequence
  | '. $(_ :: MemberName)'
  | '.$ $(_ :: Identifier)'

  export fun adjust_member_name(stx, esc):
    match stx
    | '$('$' && op) $(id :: Identifier)':
        let op_adj = spacer.set(op, expr_ctx)
        let id_adj = spacer.set(id, unique_member_ctx)
        '$op_adj $id_adj'
    | _:
        stx

  export fun adjust_specl_member_name(stx, esc):
    match stx
    | '$('$' && op) $(id :: Identifier)':
        let op_adj = spacer.set(op, specl_expr_ctx)
        let id_adj = spacer.set(id, unique_member_ctx)
        '$op_adj $id_adj'
    | _:
        stx

  export fun adjust_dot_member_name(stx, esc):
    match stx
    | '$('.$' && op) $(id :: Identifier)':
        let op_adj = spacer.set(op, expr_ctx)
        let id_adj = spacer.set(id, unique_member_ctx)
        '$op_adj $id_adj'
    | '$('.' && op) $(id :: Identifier)':
        let op_adj = spacer.set(op, expr_ctx)
        '$op_adj $id'
    | _:
        stx

  export fun adjust_specl_dot_member_name(stx, esc):
    match stx
    | '$('.$' && op) $(id :: Identifier)':
        let op_adj = spacer.set(op, specl_expr_ctx)
        let id_adj = spacer.set(id, unique_member_ctx)
        '$op_adj $id_adj'
    | '$('.' && op) $(id :: Identifier)':
        let op_adj = spacer.set(op, specl_expr_ctx)
        '$op_adj $id'
    | _:
        stx

  //============================================================================
  export syntax_class Args:
    kind: ~term
  | '($arg, ...)'

  export syntax_class Receiver:
    kind: ~term
  | '($arg)'

  export fun arg_metavars(stx) :~ [Identifier, ...]:
    let '$('inout' || '') $(stx :: Sequence)' = stx
    match stx
    | 'specl $(cb :: Group)':
        specl_bind_metavars(cb)
    | '$(name :: Identifier) :: $(type :: Group)':
        [name, &specl_bind_metavars(type)]
    | '$(name :: Identifier)':
        [name]
    | _:
        []

  export fun adjust_arg(stx, esc):
    match stx
    | '$('inout' && inout) $(tl :: Sequence)':
        '$(spacer.adjust_term(inout, expr_ctx, esc)) $(adjust_arg_no_inout(tl, esc))'
          .relocate_group(stx)
    | _:
        adjust_arg_no_inout(stx, esc)

  fun adjust_arg_no_inout(stx, esc):
    match stx
    | '$('specl' && specl) $(cb :: Group)':
        '$(spacer.adjust_term(specl, expr_ctx, esc)) $(spacer.adjust_group(cb, specl_bind_ctx, esc))'
          .relocate_group(stx)
    | '$(name :: Identifier) $('::' && annot_op) $(type :: Group)':
        '$name $(spacer.adjust_term(annot_op, expr_ctx, esc)) $(spacer.adjust_group(type, specl_bind_ctx, esc))'
          .relocate_group(stx)
    | _:
        stx

  export fun args_metavars('$(stx :: Args)') :~ [Identifier, ...]:
    List.append(arg_metavars(stx.arg), ...)

  export fun adjust_args('$(stx :: Args)', esc):
    '($(adjust_arg(stx.arg, esc)), ...)'.relocate(stx)

  export fun receiver_metavars('$(stx :: Receiver)') :~ [Identifier, ...]:
    arg_metavars(stx.arg)

  export fun adjust_receiver('$(stx :: Receiver)', esc):
    '($(adjust_arg(stx.arg, esc)))'.relocate(stx)

  //============================================================================
  export syntax_class SpeclArgs:
    kind: ~term
  | '($arg, ...)'

  export fun specl_args_metavars('$(stx :: SpeclArgs)') :~ [Identifier, ...]:
    List.append(specl_bind_metavars(stx.arg), ...)

  export fun adjust_specl_args(stx, esc):
    spacer.adjust_term(stx, specl_bind_ctx, esc)

  //============================================================================
  export syntax_class MaybeSpeclArgs:
    kind: ~sequence
    fields: args :~ maybe(Syntax.matched_of(SpeclArgs))
  | '$(args :: SpeclArgs)'
  | '': field args = #false

  export fun maybe_specl_args_metavars('$(stx :: MaybeSpeclArgs)') :~ [Identifier, ...]:
    (stx.args ?> specl_args_metavars) || []

  export fun adjust_maybe_specl_args('$(stx :: MaybeSpeclArgs)', esc):
    (stx.args ?> adjust_specl_args(_, esc)) || stx

  //============================================================================
  export syntax_class AssignPat:
    kind: ~sequence
    fields: op args
  | '$(':=' && op) $('($_)' && args)'

  export syntax_class MaybeAssignPat:
    kind: ~sequence
    fields: pat :~ maybe(Syntax.matched_of(AssignPat))
  | '$(pat :: AssignPat)'
  | '': field pat = #false

  export fun assign_pat_metavars('$(stx :: AssignPat)') :~ [Identifier, ...]:
    args_metavars(stx.args)

  export fun maybe_assign_pat_metavars('$(stx :: MaybeAssignPat)') :~ [Identifier, ...]:
    (stx.pat ?> assign_pat_metavars) || []

  export fun adjust_assign_pat('$(stx :: AssignPat)', esc):
    let op_adj = spacer.adjust_term(stx.op, expr_ctx, esc)
    let args_adj = adjust_args(stx.args, esc)
    '$op_adj $args_adj'.relocate_group(stx)

  export fun adjust_maybe_assign_pat(stx, esc):
    match stx
    | '': stx
    | _: adjust_assign_pat(stx, esc)

  //============================================================================
  export syntax_class OperatorName(esc):
    kind: ~sequence
    fields: «»
  | '$(esc_name :: Name)($_)':
      match_when esc && syntax_meta.equal_binding(esc_name, esc)
  | '$(name :: Name)':
      match_when name !matches '::'

  export syntax_class OperandTerm:
    kind: ~term
    fields: «»
  | '$term':
      match_when term !is_a Operator

  export fun operand_metavars(stx) :~ [Identifier, ...]:
    match stx
    | '$(id :: Identifier)':
        [id]
    | '($arg)':
        arg_metavars(arg)

  export fun adjust_operand(stx, esc):
    match stx
    | '($arg)':
        adjust_args(stx, esc)
    | _:
        stx

  export syntax_class OperatorPat(esc):
    kind: ~sequence
    fields:
      op_name :~ Syntax
      kind :~ Symbol
      lhs :~ maybe(Term)
      rhs :~ maybe(Term)
      [operand :~ Term, ...]
  | '$(op_name :: OperatorName(esc)) $(rhs :: OperandTerm)':
      field kind = #'prefix
      field lhs = #false
      field [operand, ...] = [rhs]
  | '$(lhs :: OperandTerm) $(op_name :: OperatorName(esc)) $(rhs :: OperandTerm)':
      field kind = #'infix
      field [operand, ...] = [lhs, rhs]
  | '$(lhs :: OperandTerm) $(op_name :: OperatorName(esc))':
      field kind = #'postfix
      field rhs = #false
      field [operand, ...] = [lhs]

  export syntax_class OperatorPatMaybeParens(esc):
    kind: ~sequence
    fields:
      op_name :~ Syntax
      kind :~ Symbol
      lhs :~ maybe(Term)
      rhs :~ maybe(Term)
      [operand :~ Term, ...]
      pat_in_parens :~ Boolean
  | '($(_ :: OperatorPat(esc): open))':
      field pat_in_parens = #true
  | '$(_ :: OperatorPat(esc): open)':
      field pat_in_parens = #false

  export syntax_class OperatorCase(esc = #false):
    kind: ~group
  | '$(pat :: OperatorPatMaybeParens(esc): open) $(res_annot :: MaybeResAnnot) $(block :: MaybeBlock)'

  //============================================================================
  export fun metavariable_list_extractor(f :: Syntax -> [Identifier, ...]):
    fun(stx, space, vars):
      for fold(vars = vars) (id in f(stx)):
        doc_meta.add_metavariable(vars, id)

  //============================================================================
  export fun specl_bind_metavars(stx :: Syntax) :~ [Identifier, ...]:
    match stx
    | '($grp) $tl ...':
        specl_bind_metavars(grp) ++ specl_bind_metavars('$tl ...')
    | '$(_ :: Name) ($grp, ...) $tl ...':
        List.append(specl_bind_metavars(grp), ..., specl_bind_metavars('$tl ...'))
    | 'as $tl ...':
        specl_bind_metavars('$tl ...')
    | '$(id :: Identifier) $tl ...' when to_string(id.unwrap()) matches rx'"_"* unicode.Ll .*':
        [id] ++ specl_bind_metavars('$tl ...')
    | ':: $_ ...':
        []
    | '$_ $tl ...':
        specl_bind_metavars('$tl ...')
    | '':
        []

  export fun where_bind_metavars(stx :: Group) :~ [Identifier, ...]:
    match stx
    | '$bind ... = $_ ...':
        specl_bind_metavars('$bind ...')
    | '$bind ...: $_':
        specl_bind_metavars('$bind ...')

  export fun option_metavars(stx :: Group) :~ [Identifier, ...]:
    match stx
    | '~where: $wb; ...':
        List.append(where_bind_metavars(wb), ...)
    | '~where $wb ...':
        where_bind_metavars('$wb ...')
    | '$(_ :: Option)':
        []

  export fun block_metavars(stx :: Block) :~ [Identifier, ...]:
    let ': $(option :: Option); ...; $_; ...' = stx
    List.append(option_metavars(option), ...)

  export fun optional_block_metavars(stx :: Syntax) :~ [Identifier, ...]:
    match stx
    | ': $(block :: Block)':
        block_metavars(block)
    | '':
        []

  //============================================================================
  export fun typeset_name(name, space, subst):
    name |> doc_meta.extract_name(_, space) |> subst

  //============================================================================
  export def expr_ctx: [#'#{pille/expr}, #'#{pille/specl_expr}]
  export def global_defn_ctx: #'~defn
  export def local_defn_ctx: #'#{pille/local_defn}
  export def local_defn_or_expr_ctx: [#'#{pille/local_defn}, #'#{pille/expr}, #'#{pille/specl_expr}]
  export def operator_order_ctx: #'~operator_order
  export def priority_ctx: #'#{pille/priority}
  export def specl_annot_ctx: #'#{pille/specl_annot}
  export def specl_bind_ctx: [#'#{pille/specl_bind}, #'#{pille/specl_expr}]
  export def specl_expr_ctx: #'#{pille/specl_expr}
  export def unique_member_ctx: #'#{pille/unique_member}

  //============================================================================
  export fun adjust_where_bind(stx :: Group, esc) :~ Group:
    let adj :~ Syntax = match stx
    | '$(lhs :: SimpleNonemptySequence) $('=' && eq_op) $(rhs :: NonemptySequence)':
        let lhs_adj = spacer.adjust_group(lhs, specl_bind_ctx, esc)
        let eq_op_adj = spacer.adjust_term(eq_op, specl_expr_ctx, esc)
        let rhs_adj = spacer.adjust_group(rhs, specl_expr_ctx, esc)
        '$lhs_adj $eq_op_adj $rhs_adj'
    | '$(lhs :: Group): $(rhs :: Group)':
        let lhs_adj = spacer.adjust_group(lhs, specl_bind_ctx, esc)
        let rhs_adj = spacer.adjust_group(rhs, specl_expr_ctx, esc)
        '$lhs_adj: $rhs_adj'
    adj.relocate_group(stx)

  export fun adjust_option(stx :: Group, esc) :~ Group:
    let '$(kw :: Keyword) $(tl :: Sequence)' = stx
    try ~escape_as ret:
      let tl_adj :~ Syntax = match kw.unwrap()
      | #'~when:
          spacer.adjust_group(tl, specl_expr_ctx, esc)
      | #'~where:
          match tl
          | ': $wb; ...':
              ': $(adjust_where_bind(wb, esc)); ...'.relocate(tl)
          | _:
              adjust_where_bind(tl, esc)
      | #'~order:
          spacer.adjust_group(tl, operator_order_ctx, esc)
      | #'~priority:
          spacer.adjust_group(tl, priority_ctx, esc)
      | _:
          ret(stx)
      '$kw $tl_adj'.relocate_group(stx)

  export fun adjust_block(
    ~adjust_body: adjust_body :: (Group, Name) -> Group: fun(stx, _): stx,
    stx :: Block,
    esc,
  ):
    let ': $(option :: Option); ...; $body; ...' = stx
    ': $(adjust_option(option, esc)); ...; $(adjust_body(body, esc).relocate_group(body)); ...'.relocate(stx)

  export fun adjust_optional_block(~adjust_body = fun(stx, _): stx, stx :: Syntax, esc):
    match stx
    | ': $(block :: Block)':
        adjust_block(~adjust_body, block, esc)
    | '':
        ''

  export fun adjust_specl_expr_body(stx, esc):
    spacer.adjust_group(stx, specl_expr_ctx, esc)

  export fun adjust_expr_body(stx, esc):
    spacer.adjust_group(stx, local_defn_or_expr_ctx, esc)
