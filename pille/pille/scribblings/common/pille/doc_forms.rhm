//==============================================================================
doc.bridge specl.operator:
  syntax_class DocForm:
    kind: ~group
  | '$(defn_op :: IdentifierName) $(_ :: OperatorCase: open)'

  doc_meta.transformer(
    ~extract_desc:
      fun(_):
        "specl operator",
    ~extract_space:
      fun(_):
        #'#{pille/specl_expr},
    ~extract_name:
      fun('$(stx :: DocForm)', space):
        doc_meta.extract_name(stx.op_name, space),
    ~extract_metavariables:
      metavariable_list_extractor <| fun('$(stx :: DocForm)'):
        List.append(
          specl_bind_metavars(stx.operand), ...,
          optional_block_metavars(stx.block)),
    ~extract_typeset:
      fun('$(stx :: DocForm)', space, subst):
        let op_name_ts = typeset_name(stx.op_name, space, subst)
        let pat_ts = '$(stx.lhs || '') $op_name_ts $(stx.rhs || '')'
        let pat_ts:
          if stx.pat_in_parens
          | '($pat_ts)'.relocate(stx.pat)
          | pat_ts
        doc_meta.typeset_rhombusblock(
          '$stx.defn_op $pat_ts $stx.res_annot $stx.block',
          ~at: stx))

spacer.bridge specl.operator(self, tail, ctx, esc):
  ~in: ~defn
  match tail
  | '$(case :: OperatorCase(esc))':
      let pat_adj = spacer.adjust_group(case.pat, specl_bind_ctx, esc)
      let res_annot_adj = adjust_maybe_specl_res_annot(case.res_annot, esc)
      let block_adj = adjust_optional_block(~adjust_body: adjust_specl_expr_body, case.block, esc)
      '$self $pat_adj $res_annot_adj $block_adj'
  | _:
      spacer.adjust_rest_sequence(self, tail, ctx, esc)

//==============================================================================
export doc.bridge operator:
  syntax_class DocForm:
    kind: ~group
  | '$(defn_op :: IdentifierName) $(case :: OperatorCase: open)'

  doc_meta.transformer(
    ~extract_desc:
      fun(_):
        "operator",
    ~extract_space:
      fun(_):
        #'#{pille/expr},
    ~extract_name:
      fun('$(stx :: DocForm)', space):
        doc_meta.extract_name(stx.op_name, space),
    ~extract_metavariables:
      metavariable_list_extractor <| fun('$(stx :: DocForm)'):
        List.append(
          (stx.lhs ?> operand_metavars) || [],
          (stx.rhs ?> operand_metavars) || [],
          optional_block_metavars(stx.block)),
    ~extract_typeset:
      fun('$(stx :: DocForm)', space, subst):
        let op_name_ts = typeset_name(stx.op_name, space, subst)
        let pat_ts = '$(stx.lhs || '') $op_name_ts $(stx.rhs || '')'
        let pat_ts:
          if stx.pat_in_parens
          | '($pat_ts)'.relocate(stx.pat)
          | pat_ts
        doc_meta.typeset_rhombusblock(
          '$stx.defn_op $pat_ts $stx.res_annot $stx.block',
          ~at: stx))

export spacer.bridge operator(self, tail, ctx, esc):
  ~in: ~defn
  match tail
  | '$(case :: OperatorCase(esc))':
      let lhs_adj = (case.lhs ?> adjust_operand(_, esc)) || ''
      let rhs_adj = (case.rhs ?> adjust_operand(_, esc)) || ''
      let pat_adj = '$lhs_adj $case.op_name $rhs_adj'
      let pat_adj = if case.pat_in_parens
      | '($pat_adj)'.relocate(case.pat)
      | pat_adj
      let res_annot_adj = adjust_maybe_res_annot(case.res_annot, esc)
      let block_adj = adjust_optional_block(~adjust_body: adjust_expr_body, case.block, esc)
      '$self $pat_adj $res_annot_adj $block_adj'
  | _:
      spacer.adjust_rest_sequence(self, tail, ctx, esc)

//==============================================================================
export doc.bridge coercion:
  syntax_class DocForm:
    kind: ~group
  | '$(op :: IdentifierName) \
     $(receiver :: Receiver) \
     $('::' && ann_op) $(to_bind :: SimpleNonemptySequence) \
     $(block :: MaybeBlock)'

  doc_meta.transformer(
    ~extract_desc:
      fun(_):
        "coercion",
    ~extract_space:
      fun(_):
        #'#{pille/expr},
    ~extract_name:
      fun(_, _):
        [],
    ~extract_metavariables:
      metavariable_list_extractor <| fun('$(stx :: DocForm)'):
        List.append(
          receiver_metavars(stx.receiver),
          specl_bind_metavars(stx.to_bind),
          optional_block_metavars(stx.block)),
    ~extract_typeset:
      fun(stx, space, subst):
        doc_meta.typeset_rhombusblock(stx))

export spacer.bridge coercion(self, tail, ctx, esc):
  ~in: ~defn
  match tail
  | '$receiver \
     $('::' && ann_op) \
     $(to_bind :: SimpleNonemptySequence) \
     $(block :: MaybeBlock)':
      let receiver_adj = adjust_args(receiver, esc)
      let ann_op_adj = spacer.adjust_term(ann_op, expr_ctx, esc)
      let to_bind_adj = spacer.adjust_group(to_bind, specl_bind_ctx, esc)
      let block_adj = adjust_optional_block(~adjust_body: adjust_expr_body, block, esc)
      '$self $receiver_adj $ann_op_adj $to_bind_adj $block_adj'
  | _:
      spacer.adjust_rest_sequence(self, tail, ctx, esc)

//==============================================================================
export doc.bridge unify:
  syntax_class DocForm:
    kind: ~group
  | '$(unify :: IdentifierName) ($fst_bind, $snd_bind) $(block :: MaybeBlock)'

  doc_meta.transformer(
    ~extract_desc:
      fun(_):
        "unification",
    ~extract_space:
      fun(_):
        #'#{pille/specl_expr},
    ~extract_name:
      fun(_, _):
        [],
    ~extract_metavariables:
      metavariable_list_extractor <| fun('$(stx :: DocForm)'):
        List.append(
          specl_bind_metavars(stx.fst_bind),
          specl_bind_metavars(stx.snd_bind),
          optional_block_metavars(stx.block)),
    ~extract_typeset:
      fun(stx, space, subst):
        doc_meta.typeset_rhombusblock(stx))

export spacer.bridge unify(self, tail, ctx, esc):
  ~in: ~defn #{pille/specl_expr}
  match ctx
  | #'#{pille/specl_expr}:
      spacer.adjust_rest_sequence(self, tail, ctx, esc)
  | _:
      match tail
      | '$binds $(block :: MaybeBlock)':
          let binds_adj = adjust_specl_args(binds, esc)
          let block_adj = adjust_optional_block(~adjust_body: adjust_specl_expr_body, block, esc)
          '$self $binds_adj $block_adj'
      | _:
          spacer.adjust_rest_sequence(self, tail, ctx, esc)
