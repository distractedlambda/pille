doc.bridge specl.def:
  doc_meta.transformer(
    ~extract_desc:
      fun(_):
        "specl definition",
    ~extract_space:
      fun(_):
        #'#{pille/specl_expr},
    ~extract_name:
      doc_meta.head_extract_name,
    ~extract_metavariables:
      doc_meta.head_extract_metavariables,
    ~extract_typeset:
      doc_meta.head_extract_typeset)

spacer.bridge specl.def(self, tail, ctx, esc):
  ~in: ~defn
  match tail
  | '$(name :: NameOrEsc(esc)) \
     $(res_annot :: MaybeResAnnot) \
     $(block :: MaybeBlock)':
      let res_annot_adj = adjust_maybe_specl_res_annot(res_annot, esc)
      let block_adj = adjust_optional_block(~adjust_body: adjust_specl_expr_body, block, esc)
      '$self $name $res_annot_adj $block_adj'
  | _:
      spacer.adjust_rest_sequence(self, tail, ctx, esc)

//==============================================================================
doc.bridge specl.fun:
  syntax_class DocForm:
    kind: ~group
  | '$(op :: IdentifierName) \
     $(name :: IdentifierName) \
     $(args :: Args: open) \
     $(res_annot :: MaybeResAnnot) \
     $(block :: MaybeBlock)'

  doc_meta.transformer(
    ~extract_desc:
      fun(_):
        "specl function",
    ~extract_space:
      fun(_):
        #'#{pille/specl_expr},
    ~extract_name:
      doc_meta.head_extract_name,
    ~extract_metavariables:
      metavariable_list_extractor <| fun('$(stx :: DocForm)'):
        List.append(
          specl_bind_metavars(stx.arg), ...,
          optional_block_metavars(stx.block)),
    ~extract_typeset:
      doc_meta.head_extract_typeset)

spacer.bridge specl.fun(self, tail, ctx, esc):
  ~in: ~defn
  match tail
  | '$(name :: NameOrEsc(esc)) \
     $args \
     $(res_annot :: MaybeResAnnot) \
     $(block :: MaybeBlock)':
      let args_adj = adjust_specl_args(args, esc)
      let res_annot_adj = adjust_maybe_specl_res_annot(res_annot, esc)
      let block_adj = adjust_optional_block(~adjust_body: adjust_specl_expr_body, block, esc)
      '$self $name $args_adj $res_annot_adj $block_adj'
  | _:
      spacer.adjust_rest_sequence(self, tail, ctx, esc)

//==============================================================================
doc.bridge specl.method:
  syntax_class DocForm:
    kind: ~group
  | '$(op :: IdentifierName) \
     $(receiver :: Receiver) \
     $(dot_member_name :: DotMemberName) \
     $(args :: SpeclArgs) \
     $(res_annot :: MaybeResAnnot) \
     $(block :: MaybeBlock)'

  doc_meta.transformer(
    ~extract_desc:
      fun(_):
        "specl method",
    ~extract_space:
      fun(_):
        #'#{pille/specl_expr},
    ~extract_name:
      fun(&_):
        [],
    ~extract_metavariables:
      metavariable_list_extractor <| fun('$(stx :: DocForm)'):
        List.append(
          specl_bind_metavars(stx.receiver.arg),
          specl_bind_metavars(stx.args.arg), ...,
          optional_block_metavars(stx.block)),
    ~extract_typeset:
      fun(stx, space, subst):
        doc_meta.typeset_rhombusblock(stx))

spacer.bridge specl.method(self, tail, ctx, esc):
  ~in: ~defn
  match tail
  | '$receiver \
     $(dmn :: DotMemberName) \
     $args \
     $(res_annot :: MaybeResAnnot) \
     $(block :: MaybeBlock)':
      let receiver_adj = adjust_specl_args(receiver, esc)
      let dmn_adj = adjust_specl_dot_member_name(dmn, esc)
      let args_adj = adjust_specl_args(args, esc)
      let res_annot_adj = adjust_maybe_specl_res_annot(res_annot, esc)
      let block_adj = adjust_optional_block(~adjust_body: adjust_specl_expr_body, block, esc)
      '$self $receiver_adj $dmn_adj $args_adj $res_annot_adj $block_adj'
  | _:
      spacer.adjust_rest_sequence(self, tail, ctx, esc)

