#lang rhombus/static/and_meta

import:
  "syntax.rhm" open
  rhombus/scribble/manual
  scribble/doc_meta open
  scribble/spacer

export only_space namespace:
  expr

//==============================================================================
export namespace specl
export namespace specl_annot
export namespace specl_bind
export namespace specl_expr
export namespace global_defn
export namespace labeled_expr
export namespace local_defn

//==============================================================================
defn.macro 'identifier_macro_doc_forms:
              $(name :: IdentifierName) $(desc :: String) $(space :: Identifier)
              ...':
  'doc.bridge $name:
     doc_meta.transformer(
       ~extract_desc:
         fun(_):
           $desc,
       ~extract_space:
         fun(_):
           #'$space,
       ~extract_name:
         doc_meta.identifier_macro_extract_name,
       ~extract_metavariables:
         doc_meta.identifier_macro_extract_metavariables,
       ~extract_typeset:
         doc_meta.identifier_macro_extract_typeset)
   ...'

identifier_macro_doc_forms:
  global_defn.macro "global definition" #{rhombus/defn}
  labeled_expr.macro "labeled expression" #{pille/labeled_expr}
  local_defn.macro "local definition" #{pille/local_defn}

//==============================================================================
defn.macro 'operator_macro_doc_forms:
              $(name :: IdentifierName) $(desc :: String) $(space :: Identifier)
              ...':
  'doc.bridge $name:
     doc_meta.transformer(
       ~extract_desc:
         fun(_):
           $desc,
       ~extract_space:
         fun(_):
           #'$space,
       ~extract_name:
         doc_meta.operator_macro_extract_name,
       ~extract_metavariables:
         doc_meta.operator_macro_extract_metavariables,
       ~extract_typeset:
         doc_meta.operator_macro_extract_typeset)
   ...'

operator_macro_doc_forms:
  specl_annot.macro "specl annotation" #{pille/specl_annot}
  specl_bind.macro "specl binding" #{pille/specl_bind}
  specl_expr.macro "specl expression" #{pille/specl_expr}
  expr.macro "expression" #{pille/expr}

//==============================================================================
export doc.bridge unique_member:
  doc_meta.transformer(
    ~extract_desc:
      fun(_):
        "unique member",
    ~extract_space:
      fun(_):
        #'#{pille/unique_member},
    ~extract_name:
      doc_meta.head_extract_name,
    ~extract_metavariables:
      fun(_, _, vars):
        vars,
    ~extract_typeset:
      doc_meta.head_extract_typeset)

//==============================================================================
export doc.bridge priority:
  syntax_class DocForm:
    kind: ~group
    fields:
      op
      name
  | '$(op :: IdentifierName) $(name :: Identifier)'

  doc_meta.transformer(
    ~extract_desc:
      fun(_):
        "overload priority",
    ~extract_space:
      fun(_):
        #'#{pille/priority},
    ~extract_name:
      doc_meta.head_extract_name,
    ~extract_metavariables:
      fun(_, _, vars):
        vars,
    ~extract_typeset:
      doc_meta.head_extract_typeset)

//==============================================================================
export doc.bridge type:
  syntax_class DocForm:
    kind: ~group
    fields:
      name
      specl_args
  | '$(_ :: IdentifierName) $(name :: IdentifierName) $(specl_args :: MaybeSpeclArgs)'

  doc_meta.transformer(
    ~extract_desc:
      fun(_):
        "type",
    ~extract_space:
      fun(_):
        [#'#{pille/specl_expr}, #'#{pille/specl_bind}],
    ~extract_name:
      doc_meta.head_extract_name,
    ~extract_metavariables:
      metavariable_list_extractor <| fun('$(stx :: DocForm)'):
        maybe_specl_args_metavars(stx.specl_args),
    ~extract_typeset:
      fun('$(stx :: DocForm)', space, subst):
        let name_ts = typeset_name(stx.name, space, subst)
        let specl_args_ts = match stx.specl_args
        | '': ''
        | args: '#,$('(manual.rhombus($args, ~at: pille/specl_bind; pille/specl_expr))'.relocate(args))'
        doc_meta.typeset_rhombusblock(
          '$name_ts $specl_args_ts',
          ~at: stx))

//==============================================================================
export doc.bridge struct:
  syntax_class DocForm:
    kind: ~group
  | '$(op :: IdentifierName) \
     $(name :: IdentifierName) \
     $(specl_args :: MaybeSpeclArgs) \
     $_ ...'

  doc_meta.transformer(
    ~extract_desc:
      fun(_):
        "struct",
    ~extract_space:
      fun(_):
        [#'#{pille/specl_expr}, #'#{pille/specl_bind}],
    ~extract_name:
      doc_meta.head_extract_name,
    ~extract_metavariables:
      metavariable_list_extractor <| fun('$(stx :: DocForm)'):
        maybe_specl_args_metavars(stx.specl_args),
    ~extract_typeset:
      doc_meta.head_extract_typeset)

export spacer.bridge struct(self, tail, ctx, esc):
  ~in: ~defn
  match tail
  | '$(name :: NameOrEsc(esc)) \
     $(specl_args :: MaybeSpeclArgs) \
     $(block :: MaybeBlock)':
      let specl_args_adj = adjust_maybe_specl_args(specl_args, esc)
      let block_adj = adjust_optional_block(
        ~adjust_body:
          fun(stx, esc):
            match stx
            | '$(member :: MemberName) $('::' && ann_op) $(type :: Group)':
                let member_adj = adjust_member_name(member, esc)
                let ann_op_adj = spacer.adjust_term(ann_op, expr_ctx, esc)
                let type_adj = spacer.adjust_group(type, specl_expr_ctx, esc)
                '$member_adj $ann_op_adj $type_adj'.relocate_group(stx)
            | _:
                stx,
        block, esc)
      '$self $name $specl_args_adj $block_adj'
  | _:
      spacer.adjust_rest_sequence(self, tail, ctx, esc)

