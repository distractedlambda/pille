#lang rhombus/static/and_meta

import:
  "syntax.rhm" open
  scribble/spacer

//==============================================================================
export spacer.bridge ::(~left: left, self, tail, ctx, esc):
  ~in: #'#{pille/specl_bind} #'#{pille/specl_expr} #'#{pille/expr}
  let tail_ctx = match ctx
  | #'#{pille/expr} || [#'#{pille/expr}, &_]:
      #'#{pille/specl_expr}
  | _:
      #'#{pille/specl_annot}
  let tail_adj = spacer.adjust_sequence(tail, tail_ctx, esc)
  '$left $self $tail_adj'

//==============================================================================
export spacer.bridge specl(self, tail, ctx, esc):
  ~in: #'#{pille/expr}
  match tail
  | '$('($_)' && arg) $(tail :: Sequence)':
      let arg_adj = spacer.adjust_term(arg, specl_expr_ctx, esc)
      spacer.adjust_rest_sequence('$self $arg_adj', tail, ctx, esc)
  | _:
      spacer.adjust_rest_sequence(self, tail, ctx, esc)

//==============================================================================
export spacer.bridge type_of(self, tail, ctx, esc):
  ~in: #'#{pille/specl_expr} #'#{pille/expr}
  match tail
  | '$('($_)' && arg) $(tail :: Sequence)':
      let arg_adj = spacer.adjust_term(arg, expr_ctx, esc)
      spacer.adjust_rest_sequence('$self $arg_adj', tail, ctx, esc)
  | _:
      spacer.adjust_rest_sequence(self, tail, ctx, esc)

//==============================================================================
export spacer.bridge equal_to(self, tail, ctx, esc):
  ~in: #'#{pille/specl_bind}
  match tail
  | '$('($_)' && arg) $(tail :: Sequence)':
      let arg_adj = spacer.adjust_term(arg, specl_expr_ctx, esc)
      spacer.adjust_rest_sequence('$self $arg_adj', tail, ctx, esc)
  | _:
      spacer.adjust_rest_sequence(self, tail, ctx, esc)

//==============================================================================
export spacer.bridge .$(~left: left, self, tail, ctx, esc):
  ~in: #'#{pille/expr} #'#{pille/specl_expr}
  match tail
  | '$(id :: Identifier) $(tail :: Sequence)':
      let id_adj = spacer.set(id, unique_member_ctx)
      spacer.adjust_rest_sequence('$left $self $id_adj', tail, ctx, esc)
  | _:
      let tail_adj = spacer.adjust_sequence(tail, ctx, esc)
      '$self $tail_adj'

//==============================================================================
export spacer.bridge $(self, tail, ctx, esc):
  ~in: #'#{pille/expr} #'#{pille/specl_expr}
  match tail
  | '$(id :: Identifier) $(tail :: Sequence)':
      let id_adj = spacer.set(id, unique_member_ctx)
      spacer.adjust_rest_sequence('$self $id_adj', tail, ctx, esc)
  | _:
      let tail_adj = spacer.adjust_sequence(tail, ctx, esc)
      '$self $tail_adj'
