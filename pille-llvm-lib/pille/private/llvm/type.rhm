#lang rhombus/static/and_meta

import:
  "c_types.rhm" open
  "context.rhm" open
  "enums.rhm" open
  "llvm_c.rhm" open
  "type_util.rhm" open

//==============================================================================
export annot.delayed_declare _Constant

//==============================================================================
// Every type reaches Rhombus tagged with its most specific class, so each
// of these veneers checks only a tag.

export veneer Type(this :: LLVMType):
  constructor ~error

  export alias 'Kind': 'TypeKind'

  property kind :~ Kind:
    LLVMGetTypeKind(this) |> decode_type_kind

  property context :~ Context:
    LLVMGetTypeContext(this)

  method to_string() :~ String:
    LLVMPrintTypeToString(this)

//==============================================================================
export veneer VoidType(this :: LLVMVoidTy):
  extends Type
  constructor(context :: Context):
    LLVMVoidTypeInContext(context)

//==============================================================================
export veneer LabelType(this :: LLVMLabelTy):
  extends Type
  constructor(context :: Context):
    LLVMLabelTypeInContext(context)

//==============================================================================
export veneer TokenType(this :: LLVMTokenTy):
  extends Type
  constructor(context :: Context):
    LLVMTokenTypeInContext(context)

//==============================================================================
export veneer MetadataType(this :: LLVMMetadataTy):
  extends Type
  constructor(context :: Context):
    LLVMMetadataTypeInContext(context)

//==============================================================================
export veneer SizedType(this :: LLVMSizedTy):
  extends Type

  constructor ~error

  // `x86_amx` has no null value.
  property null_value :~ _Constant:
    when this is_a LLVMX86AMXTy
    | bad_type("SizedType.null_value", "type", "a type with a null value", this)
    LLVMConstNull(this)

//==============================================================================
export veneer IntType(this :: LLVMIntTy):
  extends SizedType

  constructor(context :: Context, width :: Int.in(1, max_int_bits)):
    LLVMIntTypeInContext(context, width)

  property width :~ PosInt:
    LLVMGetIntTypeWidth(this)

//==============================================================================
export veneer HalfType(this :: LLVMHalfTy):
  extends SizedType

  constructor(context :: Context):
    LLVMHalfTypeInContext(context)

//==============================================================================
export veneer FloatType(this :: LLVMFloatTy):
  extends SizedType

  constructor(context :: Context):
    LLVMFloatTypeInContext(context)

//==============================================================================
export veneer DoubleType(this :: LLVMDoubleTy):
  extends SizedType

  constructor(context :: Context):
    LLVMDoubleTypeInContext(context)

//==============================================================================
fun is_return_type(t):
  !(t is_a LLVMFunctionTy || t is_a LLVMLabelTy || t is_a LLVMMetadataTy)

fun is_param_type(t):
  !(t is_a LLVMVoidTy || t is_a LLVMFunctionTy)

annot.macro 'ReturnType':
  'Type && satisfying(is_return_type)'

annot.macro 'ParamType':
  'Type && satisfying(is_param_type)'

export veneer FunctionType(this :: LLVMFunctionTy):
  extends Type

  constructor(return_type :: ReturnType,
              param_types :: Listable.to_list && [ParamType, ...],
              ~is_var_arg: is_var_arg :: Any = #false):
    LLVMFunctionType(return_type, param_types, is_var_arg)

  property is_var_arg :~ Boolean:
    LLVMIsFunctionVarArg(this)

  property return_type :~ Type:
    LLVMGetReturnType(this)

  property param_types :~ List.of(Type):
    LLVMGetParamTypes(this)

//==============================================================================
export veneer StructType(this :: LLVMStructTy):
  extends SizedType

  constructor(
    context :: Context,
    element_types :: Listable.to_list && [SizedType, ...],
    ~packed: packed :: Any = #false,
  ):
    LLVMStructTypeInContext(context, element_types, packed)

  property is_packed :~ Boolean:
    LLVMIsPackedStruct(this)

  // The elements of a sized struct are sized.
  property element_types :~ List.of(SizedType):
    LLVMGetStructElementTypes(this)

//==============================================================================
fun is_array_element_type(t):
  !(t is_a LLVMX86AMXTy || t is_a LLVMScalableVectorTy)

annot.macro 'ArrayElementType':
  'SizedType && satisfying(is_array_element_type)'

export veneer ArrayType(this :: LLVMArrayTy):
  extends SizedType

  constructor(element_type :: ArrayElementType, length :: Int.in(0, 2 ** 64 - 1)):
    LLVMArrayType2(element_type, length)

  // The element of a sized array is sized.
  property element_type :~ SizedType:
    LLVMGetElementType(this)

  property length :~ NonnegInt:
    LLVMGetArrayLength2(this)

//==============================================================================
export veneer PointerType(this :: LLVMPointerTy):
  extends SizedType

  constructor(context :: Context, ~address_space: address_space :: AddressSpace = 0):
    LLVMPointerTypeInContext(context, address_space)

  property address_space :~ NonnegInt:
    LLVMGetPointerAddressSpace(this)

//==============================================================================
annot.macro 'VectorElementType':
  'Type && satisfying(is_vector_element_type)'

export veneer VectorType(this :: LLVMVectorTy):
  extends SizedType

  constructor(element_type :: VectorElementType, length :: Int.in(1, 2 ** 32 - 1)):
    LLVMVectorType(element_type, length)

  // Vector elements are ints, floats or pointers, which are all sized.
  property element_type :~ SizedType:
    LLVMGetElementType(this)

  property length :~ PosInt:
    LLVMGetVectorSize(this)
