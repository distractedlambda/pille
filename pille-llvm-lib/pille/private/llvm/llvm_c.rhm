c.fun LLVMGetValueName2(LLVMValue*, len :: (size_t*) = new size_t) :: (p :: ptr_t):
  let n = len[0]
  let bs = Bytes.make(n)
  memcpy(cast ~from (bytes_ptr_t) ~to (ptr_t) bs, p, n)
  bs.utf8_string()

