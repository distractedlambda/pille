//==============================================================================
// Whole modules

c.fun _LLVMParseBitcodeInContext2(
  LLVMContext*,
  LLVMMemoryBuffer*,
  mod :: (ptr_t*) = new ptr_t,
) :: (failed :: boolint_t):
  ~c_id: LLVMParseBitcodeInContext2
  !failed && cast (LLVMModule*) mod[0]

fun LLVMParseBitcodeInContext2(context, bitcode :~ Bytes):
  let buf = LLVMCreateMemoryBufferWithMemoryRangeCopy(bitcode)
  try:
    _LLVMParseBitcodeInContext2(context, buf)
    ~finally:
      LLVMDisposeMemoryBuffer(buf)

c.fun LLVMWriteBitcodeToMemoryBuffer(LLVMModule*) :: (buf :: LLVMMemoryBuffer*):
  take_buffer_bytes(buf)

// With `LLVMReturnStatusAction`, LLVM always allocates a message, even when
// verification succeeds.
c.fun LLVMVerifyModule(
  LLVMModule*,
  int_t = 2,
  msg :: (ptr_t*) = new ptr_t,
) :: (failed :: boolint_t):
  let message = cast ~to (message_t) msg[0]
  failed && (if message == "" | "verification failed" | message)

