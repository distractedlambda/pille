#lang rhombus/static/and_meta

// Declarations of the LLVM C functions that `pille/llvm` uses.
//
// This module is unsafe, so the FFI does not check arguments against their
// foreign types. The veneers check every argument before they get here, and
// checking again would only repeat that work. Anything else that calls these
// functions must check its arguments first.

import:
  rhombus/unsafe open
  ffi open
  "c_types.rhm" open
  "paths.rhm" open

use_unsafe

export:
  all_defined

foreign.linker c:
  ~lib: Lib.load(llvm_lib_path(), [])

//==============================================================================
c.fun LLVMGetVersion(
  major :: (uint_t*) = new uint_t,
  minor :: (uint_t*) = new uint_t,
  patch :: (uint_t*) = new uint_t,
) :: void_t:
  values(major[0], minor[0], patch[0])

block:
  let (major, minor, _) = LLVMGetVersion()
  unless major == 23 && minor >= 1
  | error("unsupported LLVM version",
          error.val(~label: "version", @str{@major.@minor}))

//==============================================================================
// Strings that LLVM allocates and that we must free after copying.

c.fun LLVMDisposeMessage(ptr_t) :: void_t

foreign.type message_t:
  ~extends ptr_t
  ~c_to_rhombus: fun (p):
                   if ptr_to_uintptr(p) == 0
                   | ""
                   | let s = cast ~to (string_t) p
                     LLVMDisposeMessage(p)
                     s

//==============================================================================
c.fun LLVMCreateMemoryBufferWithMemoryRangeCopy(
  bs :: bytes_ptr_t,
  size_t = (bs :~ Bytes).length(),
  name_t = #false,
) :: LLVMMemoryBuffer*

c.fun LLVMGetBufferStart(LLVMMemoryBuffer*) :: ptr_t
c.fun LLVMGetBufferSize(LLVMMemoryBuffer*) :: size_t
c.fun LLVMDisposeMemoryBuffer(LLVMMemoryBuffer*) :: void_t

fun take_buffer_bytes(buf) :~ ImmutableBytes:
  let n = LLVMGetBufferSize(buf)
  let bs = Bytes.make(n)
  memcpy(cast ~from (bytes_ptr_t) ~to (ptr_t) bs, LLVMGetBufferStart(buf), n)
  LLVMDisposeMemoryBuffer(buf)
  bs.snapshot()

//==============================================================================
// An `error_t` result is `#false` for success, or else the error's message.

c.fun LLVMGetErrorMessage(LLVMError*) :: ptr_t
c.fun LLVMDisposeErrorMessage(ptr_t) :: void_t

foreign.type error_t:
  ~extends ptr_t
  ~c_to_rhombus: fun (p):
                   if ptr_to_uintptr(p) == 0
                   | #false
                   | let msg_p = LLVMGetErrorMessage(cast (LLVMError*) p)
                     let msg = cast ~to (string_t) msg_p
                     LLVMDisposeErrorMessage(msg_p)
                     msg

fun check_error(who, msg) :: Void:
  when msg
  | error(~who: who, msg)

