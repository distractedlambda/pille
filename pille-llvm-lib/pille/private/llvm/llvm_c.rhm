  LLVMBuildFDiv
  LLVMBuildURem
  LLVMBuildSRem
  LLVMBuildFRem
  LLVMBuildShl
  LLVMBuildLShr
  LLVMBuildAShr
  LLVMBuildAnd
  LLVMBuildOr
  LLVMBuildXor

builders (LLVMValue*, LLVMType*):
