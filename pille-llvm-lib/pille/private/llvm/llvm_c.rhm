) :: void_t

// The `LLVMIsA...` functions return their argument or NULL. We only need to
// know which, so we read the result as an integer and avoid allocating.
defn.macro 'value_class_predicates:
              $(name :: Identifier)
              ...':
  let [c_name, ...] = [Syntax.make_id("LLVMIsA" +& name.unwrap(), name), ...]
  'c.fun $c_name(LLVMValue*) :: (r :: uintptr_t):
     r != 0
   ...'

value_class_predicates:
  AllocaInst
  Argument
  BranchInst
  CallInst
  CastInst
  Constant
  ConstantFP
  ConstantInt
  ConstantPointerNull
  Function
  GlobalObject
  GlobalValue
  GlobalVariable
  Instruction
  LoadInst
  PHINode
  PoisonValue
  ReturnInst
  StoreInst
  TruncInst
  UnaryInstruction
  UndefValue
  UnreachableInst
  User
  ZExtInst

