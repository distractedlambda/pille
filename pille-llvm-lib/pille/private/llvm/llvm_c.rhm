c.fun LLVMDisposePassBuilderOptions(LLVMPassBuilderOptions*) :: void_t
c.fun LLVMRunPasses(
  LLVMModule*,
  name_t,
  LLVMTargetMachine_or_null,
  LLVMPassBuilderOptions*,
) :: (msg :: error_t):
  check_error("LLVMRunPasses", msg)

// The source module is destroyed.
c.fun LLVMLinkModules2(LLVMModule*, LLVMModule*) :: (failed :: boolint_t):
  when failed
  | error("failed to link modules")

//==============================================================================
// ORC

c.fun LLVMOrcCreateNewThreadSafeContextFromLLVMContext(
  LLVMContext*,
) :: LLVMOrcThreadSafeContext*
c.fun LLVMOrcDisposeThreadSafeContext(LLVMOrcThreadSafeContext*) :: void_t
c.fun LLVMOrcCreateNewThreadSafeModule(
  LLVMModule*,
  LLVMOrcThreadSafeContext*,
) :: LLVMOrcThreadSafeModule*
c.fun LLVMOrcDisposeThreadSafeModule(LLVMOrcThreadSafeModule*) :: void_t

c.fun LLVMOrcJITTargetMachineBuilderCreateFromTargetMachine(
  LLVMTargetMachine*,
) :: LLVMOrcJITTargetMachineBuilder*
c.fun LLVMOrcDisposeJITTargetMachineBuilder(LLVMOrcJITTargetMachineBuilder*) :: void_t

c.fun LLVMOrcCreateLLJITBuilder() :: LLVMOrcLLJITBuilder*
c.fun LLVMOrcLLJITBuilderSetJITTargetMachineBuilder(
  LLVMOrcLLJITBuilder*,
  LLVMOrcJITTargetMachineBuilder*,
) :: void_t
c.fun LLVMOrcDisposeLLJITBuilder(LLVMOrcLLJITBuilder*) :: void_t

c.fun LLVMOrcCreateLLJIT(
  jit :: (ptr_t*) = new ptr_t,
  LLVMOrcLLJITBuilder_or_null,
) :: (msg :: error_t):
  check_error("LLVMOrcCreateLLJIT", msg)
  cast (LLVMOrcLLJIT*) jit[0]
c.fun LLVMOrcDisposeLLJIT(LLVMOrcLLJIT*) :: (msg :: error_t):
  check_error("LLVMOrcDisposeLLJIT", msg)
c.fun LLVMOrcLLJITGetExecutionSession(LLVMOrcLLJIT*) :: LLVMOrcExecutionSession*
c.fun LLVMOrcLLJITGetMainJITDylib(LLVMOrcLLJIT*) :: LLVMOrcJITDylib*

// The JIT takes ownership of the memory buffer.
c.fun _LLVMOrcLLJITAddObjectFile(
  LLVMOrcLLJIT*,
  LLVMOrcJITDylib*,
  LLVMMemoryBuffer*,
) :: (msg :: error_t):
  ~c_id: LLVMOrcLLJITAddObjectFile
  check_error("LLVMOrcLLJITAddObjectFile", msg)

fun LLVMOrcLLJITAddObjectFile(jit, jit_dylib, contents :~ Bytes) :: Void:
  _LLVMOrcLLJITAddObjectFile(jit,
                             jit_dylib,
                             LLVMCreateMemoryBufferWithMemoryRangeCopy(contents))

c.fun LLVMOrcLLJITAddLLVMIRModule(
  LLVMOrcLLJIT*,
  LLVMOrcJITDylib*,
  LLVMOrcThreadSafeModule*,
) :: (msg :: error_t):
  check_error("LLVMOrcLLJITAddLLVMIRModule", msg)

c.fun LLVMOrcLLJITLookup(
  LLVMOrcLLJIT*,
  addr :: (uint64_t*) = new uint64_t,
  name_t,
) :: (msg :: error_t):
  check_error("LLVMOrcLLJITLookup", msg)
  uintptr_to_ptr(addr[0])
