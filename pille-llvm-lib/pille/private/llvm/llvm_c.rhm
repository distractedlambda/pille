//==============================================================================
// Target initialization. A target that this LLVM was built without has no
// initialization functions, so we skip it.

defn.macro 'target_initializers:
              $(target :: Identifier)
              ...':
  ~op_stx: self
  fun ids(fmt_pre, fmt_post):
    [Syntax.make_id(fmt_pre +& target.unwrap() +& fmt_post, target), ...]
  fun group(all_name, [id, ...]):
    let all_id = Syntax.make_id(all_name, self)
    'c.fun $id() :: void_t:
       ~fail: fun (_): #false
     ...
     fun $all_id() :: Void:
       for (f in [$id, ...]):
         when f
         | (f :~ Function)()'
  '$(group("LLVMInitializeAllTargetInfos", ids("LLVMInitialize", "TargetInfo")))
   $(group("LLVMInitializeAllTargets", ids("LLVMInitialize", "Target")))
   $(group("LLVMInitializeAllTargetMCs", ids("LLVMInitialize", "TargetMC")))
   $(group("LLVMInitializeAllAsmPrinters", ids("LLVMInitialize", "AsmPrinter")))
   $(group("LLVMInitializeAllAsmParsers", ids("LLVMInitialize", "AsmParser")))
   $(group("LLVMInitializeAllDisassemblers", ids("LLVMInitialize", "Disassembler")))'

target_initializers:
  AArch64
  AMDGPU
  ARM
  AVR
  BPF
  Hexagon
  Lanai
  LoongArch
  Mips
  MSP430
  NVPTX
  PowerPC
  RISCV
  Sparc
  SPIRV
  SystemZ
  VE
  WebAssembly
  X86
  XCore

//==============================================================================
// Targets and target machines

c.fun LLVMGetFirstTarget() :: LLVMTarget_or_null
c.fun LLVMGetNextTarget(LLVMTarget*) :: LLVMTarget_or_null
c.fun LLVMGetTargetFromName(name_t) :: LLVMTarget_or_null
c.fun LLVMGetTargetFromTriple(
  name_t,
  target :: (ptr_t*) = new ptr_t,
  msg :: (ptr_t*) = new ptr_t,
) :: (failed :: boolint_t):
  if failed
  | LLVMDisposeMessage(msg[0])
    #false
  | cast (LLVMTarget*) target[0]
