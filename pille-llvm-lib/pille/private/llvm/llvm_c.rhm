c.fun LLVMModuleCreateWithNameInContext(name_t, LLVMContext*) :: LLVMModule*
c.fun LLVMGetModuleContext(LLVMModule*) :: LLVMContext*
c.fun LLVMCloneModule(LLVMModule*) :: LLVMModule*
c.fun LLVMDisposeModule(LLVMModule*) :: void_t
c.fun LLVMPrintModuleToString(LLVMModule*) :: message_t

//==============================================================================
// Types. Functions whose result could be any kind of type return a
// `classified_type_t`, which tags the type by its kind. That costs one or two
// foreign calls, but afterward every check on the type is a tag check.

c.fun LLVMGetTypeKind(LLVMType*) :: int_t
c.fun LLVMTypeIsSized(LLVMType*) :: boolint_t

fun classify_type(p):
  fun sized(): cast (LLVMSizedTy*) p
  fun sized_or_not(): if LLVMTypeIsSized(p) | sized() | p
  match LLVMGetTypeKind(p)
  | 0: cast (LLVMVoidTy*) p
  | 1: cast (LLVMHalfTy*) p
  | 2: cast (LLVMFloatTy*) p
  | 3: cast (LLVMDoubleTy*) p
  | 7: cast (LLVMLabelTy*) p
  | 8: cast (LLVMIntTy*) p
  | 9: cast (LLVMFunctionTy*) p
  | 10:
      if LLVMTypeIsSized(p) | cast (LLVMStructTy*) p | p
  | 11:
      if LLVMTypeIsSized(p) | cast (LLVMArrayTy*) p | p
  | 12: cast (LLVMPointerTy*) p
  | 13: cast (LLVMVectorTy*) p
  | 14: cast (LLVMMetadataTy*) p
  | 16: cast (LLVMTokenTy*) p
  | 4 || 5 || 6 || 18: cast (LLVMFPTy*) p
  | 17: cast (LLVMScalableVectorTy*) p
  | 19: cast (LLVMX86AMXTy*) p
  | 20: sized_or_not()
  | 21: sized()
  | ~else: p

foreign.type classified_type_t:
  ~extends LLVMType*
  ~c_to_rhombus: classify_type

c.fun LLVMGetTypeContext(LLVMType*) :: LLVMContext*
c.fun LLVMPrintTypeToString(LLVMType*) :: message_t

c.fun LLVMVoidTypeInContext(LLVMContext*) :: LLVMVoidTy*
c.fun LLVMLabelTypeInContext(LLVMContext*) :: LLVMLabelTy*
c.fun LLVMTokenTypeInContext(LLVMContext*) :: LLVMTokenTy*
c.fun LLVMMetadataTypeInContext(LLVMContext*) :: LLVMMetadataTy*
c.fun LLVMHalfTypeInContext(LLVMContext*) :: LLVMHalfTy*
c.fun LLVMFloatTypeInContext(LLVMContext*) :: LLVMFloatTy*
c.fun LLVMDoubleTypeInContext(LLVMContext*) :: LLVMDoubleTy*

c.fun LLVMIntTypeInContext(LLVMContext*, uint_t) :: LLVMIntTy*
c.fun LLVMGetIntTypeWidth(LLVMType*) :: uint_t

c.fun LLVMFunctionType(
  LLVMType*,
  params :: list_t(LLVMType*),
  uint_t = (params :~ List).length(),
  boolint_t,
) :: LLVMFunctionTy*
c.fun LLVMIsFunctionVarArg(LLVMType*) :: boolint_t
c.fun LLVMGetReturnType(LLVMType*) :: classified_type_t
c.fun LLVMCountParamTypes(LLVMType*) :: uint_t
c.fun _LLVMGetParamTypes(LLVMType*, ptr_t) :: void_t:
  ~c_id: LLVMGetParamTypes

fun LLVMGetParamTypes(type) :~ List:
  let n = LLVMCountParamTypes(type)
  let dest = new ptr_t[n]
  _LLVMGetParamTypes(type, dest)
  for List (i in 0..n):
    classify_type(dest[i])

c.fun LLVMStructTypeInContext(
  LLVMContext*,
  elems :: list_t(LLVMType*),
  uint_t = (elems :~ List).length(),
  boolint_t,
) :: LLVMStructTy*
c.fun LLVMIsPackedStruct(LLVMType*) :: boolint_t
c.fun LLVMStructGetTypeAtIndex(LLVMType*, uint_t) :: classified_type_t
c.fun LLVMCountStructElementTypes(LLVMType*) :: uint_t
c.fun _LLVMGetStructElementTypes(LLVMType*, ptr_t) :: void_t:
  ~c_id: LLVMGetStructElementTypes

fun LLVMGetStructElementTypes(type) :~ List:
  let n = LLVMCountStructElementTypes(type)
  let dest = new ptr_t[n]
  _LLVMGetStructElementTypes(type, dest)
  for List (i in 0..n):
    classify_type(dest[i])

c.fun LLVMArrayType2(LLVMType*, uint64_t) :: LLVMArrayTy*
c.fun LLVMGetArrayLength2(LLVMType*) :: uint64_t
