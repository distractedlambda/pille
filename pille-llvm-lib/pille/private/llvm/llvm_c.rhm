c.fun LLVMCreateTargetMachine(
  LLVMTarget*,
  name_t,
  name_t,
  name_t,
  int_t,
  int_t,
  int_t,
) :: LLVMTargetMachine_or_null
c.fun LLVMDisposeTargetMachine(LLVMTargetMachine*) :: void_t
c.fun LLVMCreateTargetDataLayout(LLVMTargetMachine*) :: LLVMTargetData*

c.fun LLVMTargetMachineEmitToMemoryBuffer(
  LLVMTargetMachine*,
  LLVMModule*,
  int_t,
  msg :: (ptr_t*) = new ptr_t,
  buf :: (ptr_t*) = new ptr_t,
) :: (failed :: boolint_t):
  if failed
  | let message = cast ~to (message_t) msg[0]
    error(~who: "LLVMTargetMachineEmitToMemoryBuffer", message)
  | take_buffer_bytes(cast (LLVMMemoryBuffer*) buf[0])

