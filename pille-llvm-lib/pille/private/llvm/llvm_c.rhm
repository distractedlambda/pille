defn.macro 'builders ($arg_t, ...):
              $(name :: Identifier)
              ...':
  let [defn, ...]:
    for List (n in [name, ...]):
      'c.fun $n(LLVMBuilder*, $arg_t, ..., name_t) :: LLVMValue*'
  '$defn
   ...'

builders (LLVMValue*):
  LLVMBuildNeg
  LLVMBuildNSWNeg
  LLVMBuildFNeg
  LLVMBuildNot

builders (LLVMValue*, LLVMValue*):
  LLVMBuildAdd
  LLVMBuildNSWAdd
  LLVMBuildNUWAdd
  LLVMBuildFAdd
  LLVMBuildSub
