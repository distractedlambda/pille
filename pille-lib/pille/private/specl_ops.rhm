#lang pille/private/kernel

import:
  "generic_ops.rhm" open

export only_space namespace:
  specl

//==============================================================================
export specl.fun specl.error(message :: string):
  #%rhombus(message):
    import:
      rhombus/static open
      pille/concretize open
    error(
      ~exn: Exn.Fail.Concretize,
      message)

//==============================================================================
export specl.fun min(x :: real, y :: real):
  #%rhombus(x, y):
    import rhombus/static open
    math.min(x, y)

//==============================================================================
export specl.fun max(x :: real, y :: real):
  #%rhombus(x, y):
    import rhombus/static open
    math.max(x, y)

//==============================================================================
specl.property (α :: type).byte_size:
  #%rhombus(α):
    import:
      "runtime/compiler.rhm" open
      pille/concretize open
      rhombus/static open
    Compiler
      .require_current()
      .sizer
      .memory_layout_of(Type.repr(α))
      .size

//==============================================================================
specl.property (α :: type).byte_align:
  #%rhombus(α):
    import:
      "runtime/compiler.rhm" open
      pille/concretize open
      rhombus/static open
    Compiler
      .require_current()
      .sizer
      .memory_layout_of(Type.repr(α))
      .alignment

//==============================================================================
specl.property (α :: type).byte_stride:
  #%rhombus(α):
    import:
      "runtime/compiler.rhm" open
      pille/concretize open
      rhombus/static open
    Compiler
      .require_current()
      .sizer
      .memory_layout_of(Type.repr(α))
      .stride

//==============================================================================
specl.method (lhs :: number).$add(rhs :: number):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs + rhs

//==============================================================================
specl.method (rhs :: number).$neg():
  #%rhombus(rhs):
    import rhombus/static open
    -rhs

//==============================================================================
specl.method (lhs :: number).$sub(rhs :: number):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs - rhs

//==============================================================================
specl.method (lhs :: number).$mul(rhs :: number):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs * rhs

//==============================================================================
specl.method (lhs :: number).$div(rhs :: number):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs / rhs

specl.method (lhs :: real).$div_trunc(rhs :: real):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    math.truncate(lhs / rhs)

specl.method (lhs :: real).$div_floor(rhs :: real):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    math.floor(lhs / rhs)

specl.method (lhs :: real).$div_ceil(rhs :: real):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    math.ceiling(lhs / rhs)

//==============================================================================
specl.method (lhs :: nonneg_real).$rem(rhs :: nonneg_real):
  lhs rem_trunc rhs

specl.method (lhs :: real).$rem_trunc(rhs :: real):
  lhs - rhs * (lhs div_trunc rhs)

specl.method (lhs :: real).$rem_floor(rhs :: real):
  lhs - rhs * (lhs div_floor rhs)

specl.method (lhs :: real).$rem_ceil(rhs :: real):
  lhs - rhs * (lhs div_ceil rhs)

//==============================================================================
specl.method (lhs :: number).$pow(rhs :: number):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs ** rhs

//==============================================================================
export specl.operator lhs == rhs:
  ~order: equivalence
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs == rhs

//==============================================================================
export specl.operator lhs != rhs:
  ~order: equivalence
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs != rhs

export only_space specl_expr:
  rename != as ≠

//==============================================================================
specl.method (lhs :: comparable).$lt(rhs :: comparable):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    (lhs :~ Comparable) < rhs

//==============================================================================
specl.method (lhs :: comparable).$le(rhs :: comparable):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    (lhs :~ Comparable) <= rhs

//==============================================================================
specl.method (lhs :: comparable).$gt(rhs :: comparable):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    (lhs :~ Comparable) > rhs

//==============================================================================
specl.method (lhs :: comparable).$ge(rhs :: comparable):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    (lhs :~ Comparable) >= rhs

//==============================================================================
specl.method (rhs :: boolean).$not():
  #%rhombus(rhs):
    import rhombus/static open
    !rhs

specl.method (rhs :: int).$not():
  #%rhombus(rhs):
    import rhombus/static open
    bits.not(rhs)

//==============================================================================
specl.method (lhs :: boolean).$and(rhs :: boolean):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs && rhs

specl.method (lhs :: int).$and(rhs :: int):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs bits.and rhs

//==============================================================================
specl.method (lhs :: boolean).$or(rhs :: boolean):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs || rhs

specl.method (lhs :: int).$or(rhs :: int):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs bits.or rhs

//==============================================================================
specl.method (lhs :: boolean).$xor(rhs :: boolean):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs != rhs

specl.method (lhs :: int).$xor(rhs :: int):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs bits.xor rhs

//==============================================================================
specl.method (lhs :: int).$shl(rhs :: nat):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs bits.(<<) rhs

//==============================================================================
specl.method (lhs :: int).$shr(rhs :: nat):
  #%rhombus(lhs, rhs):
    import rhombus/static open
    lhs bits.(>>) rhs

//==============================================================================
specl.property (n :: int).bit_length:
  #%rhombus(n):
    import rhombus/static open
    bits.length(n)

//==============================================================================
global_defn.macro 'math_methods:
                     $pille_name $pille_ann $rhm_name
                     ...':
  'specl.method(x :: $pille_ann).$ $pille_name():
     #%rhombus(x):
       import rhombus/static open
       math. $rhm_name(x)
   ...'

math_methods:
  abs real abs
  acos number acos
  asin number asin
  ceil real ceiling
  cos number cos
  exp number exp
  floor real floor
  round real round
  sin number sin
  sqrt number sqrt
  tan number tan
  trunc real truncate
