#lang pille/private/kernel

import:
  "cond.rhm" open
  "specl_ops.rhm" open
  "generic_ops.rhm" open
  "panic.rhm" open
  "type_traits.rhm" open

//==============================================================================
export specl.def NativeInt:
  Int(RawPtr.byte_size * 8)

export specl.def NativeUInt:
  UInt(RawPtr.byte_size * 8)

//==============================================================================
specl.property (Int(w)).min_value:
  -(2**(w - 1))

specl.property (Int(w)).max_value:
  2**(w - 1) - 1

//==============================================================================
specl.property (UInt(w)).min_value:
  0

specl.property (UInt(w)).max_value:
  2**w - 1

//==============================================================================
coercion (from :: UInt(from_width)) :: α && UInt(to_width):
  ~when to_width > from_width
  prim.zext(from, ~to: α)

//==============================================================================
unify(UInt(w1), UInt(w2)):
  UInt(max(w1, w2))

//==============================================================================
coercion (from :: UInt(from_width)) :: α && Int(to_width):
  ~when to_width > from_width
  prim.zext(from, ~to: α)

//==============================================================================
unify(UInt(w1), Int(w2)):
  Int(max(w1 + 1, w2))

//==============================================================================
coercion (from :: Int(from_width)) :: α && Int(to_width):
  ~when to_width > from_width
  prim.sext(from, ~to: α)

//==============================================================================
unify(Int(w1), Int(w2)):
  Int(max(w1, w2))

//==============================================================================
coercion (specl value :: nat) :: α && UInt(width):
  ~when value.bit_length ≤ width
  prim.constant_int(α, value)

//==============================================================================
unify(Specl(v1 :: nat), Specl(v2 :: nat)):
  UInt(max(v1, v2).bit_length)

//==============================================================================
unify(Specl(v :: nat), UInt(w)):
  UInt(max(v.bit_length, w))

//==============================================================================
coercion (specl value :: int) :: α && Int(width):
  ~when value.bit_length < width
  prim.constant_int(α, value)

//==============================================================================
unify(Specl(v1 :: int), Specl(v2 :: int)):
  ~when v1 < 0 || v2 < 0
  Int(max(v1.bit_length, v2.bit_length) + 1)

//==============================================================================
unify(Specl(v :: int), Int(w)):
  Int(max(v.bit_length + 1, w))

//==============================================================================
method (lhs :: Int(n)).$add(rhs :: Int(n)) :: Int(n):
  cond
  | ub.allowed:
      prim.add_nsw(lhs, rhs)
  | ub.suppressed:
      prim.add(lhs, rhs)
  | ub.checked:
      let res = prim.sadd_with_overflow(lhs, rhs)
      if res[1]
      | panic()
      | res[0]

method (lhs :: Int(n)).$add_wrap(rhs :: Int(n)) :: Int(n):
  prim.add(lhs, rhs)

method (lhs :: Int(n)).$sub(rhs :: Int(n)) :: Int(n):
  cond
  | ub.allowed:
      prim.sub_nsw(lhs, rhs)
  | ub.suppressed:
      prim.sub(lhs, rhs)
  | ub.checked:
      let res = prim.ssub_with_overflow(lhs, rhs)
      if res[1]
      | panic()
      | res[0]

method (lhs :: Int(n)).$sub_wrap(rhs :: Int(n)) :: Int(n):
  prim.sub(lhs, rhs)

method (rhs :: Int(n)).$neg() :: Int(n):
  0 - rhs

method (rhs :: Int(n)).$neg_wrap() :: Int(n):
  0 -% rhs

method (lhs :: Int(n)).$mul(rhs :: Int(n)) :: Int(n):
  cond
  | ub.allowed:
      prim.mul_nsw(lhs, rhs)
  | ub.suppressed:
      prim.mul(lhs, rhs)
  | ub.checked:
      let res = prim.smul_with_overflow(lhs, rhs)
      if res[1]
      | panic()
      | res[0]

method (lhs :: Int(n)).$mul_wrap(rhs :: Int(n)) :: Int(n):
  prim.mul(lhs, rhs)

fun sdiv_safe(lhs :: Int(n), rhs :: Int(n)):
  ub.allowed || (rhs != 0 && (lhs != Int(n).min_value || rhs != -1))

method (lhs :: Int(n)).$div_trunc(rhs :: Int(n)) :: Int(n):
  cond
  | sdiv_safe(lhs, rhs):
      prim.sdiv(lhs, rhs)
  | ub.suppressed:
      0
  | ub.checked:
      panic()

method (lhs :: Int(n)).$rem_trunc(rhs :: Int(n)) :: Int(n):
  cond
  | sdiv_safe(lhs, rhs):
      prim.srem(lhs, rhs)
  | ub.suppressed:
      0
  | ub.checked:
      panic()

method (lhs :: Int(n)).$eq(rhs :: Int(n)) :: Boolean:
  prim.icmp_eq(lhs, rhs)

method (lhs :: Int(n)).$ne(rhs :: Int(n)) :: Boolean:
  prim.icmp_ne(lhs, rhs)

method (lhs :: Int(n)).$lt(rhs :: Int(n)) :: Boolean:
  prim.icmp_slt(lhs, rhs)

method (lhs :: Int(n)).$le(rhs :: Int(n)) :: Boolean:
  prim.icmp_sle(lhs, rhs)

method (lhs :: Int(n)).$gt(rhs :: Int(n)) :: Boolean:
  prim.icmp_sgt(lhs, rhs)

method (lhs :: Int(n)).$ge(rhs :: Int(n)) :: Boolean:
  prim.icmp_sge(lhs, rhs)

//==============================================================================
method (lhs :: UInt(n)).$add(rhs :: UInt(n)) :: UInt(n):
  cond
  | ub.allowed:
      prim.add_nuw(lhs, rhs)
  | ub.suppressed:
      prim.add(lhs, rhs)
  | ub.checked:
      let res = prim.uadd_with_overflow(lhs, rhs)
      if res[1]
      | panic()
      | res[0]

method (lhs :: UInt(n)).$add_wrap(rhs :: UInt(n)) :: UInt(n):
  prim.add(lhs, rhs)

method (lhs :: UInt(n)).$sub(rhs :: UInt(n)) :: UInt(n):
  cond
  | ub.allowed:
      prim.sub_nuw(lhs, rhs)
  | ub.suppressed:
      prim.sub(lhs, rhs)
  | ub.checked:
      let res = prim.usub_with_overflow(lhs, rhs)
      if res[1]
      | panic()
      | res[0]

method (lhs :: UInt(n)).$sub_wrap(rhs :: UInt(n)) :: UInt(n):
  prim.sub(lhs, rhs)

method (rhs :: UInt(n)).$neg_wrap() :: UInt(n):
  0 -% rhs

method (lhs :: UInt(n)).$mul(rhs :: UInt(n)) :: UInt(n):
  cond
  | ub.allowed:
      prim.mul_nuw(lhs, rhs)
  | ub.suppressed:
      prim.mul(lhs, rhs)
  | ub.checked:
      let res = prim.umul_with_overflow(lhs, rhs)
      if res[1]
      | panic()
      | res[0]

method (lhs :: UInt(n)).$mul_wrap(rhs :: UInt(n)) :: UInt(n):
  prim.mul(lhs, rhs)

method (lhs :: UInt(n)).$div_trunc(rhs :: UInt(n)) :: UInt(n):
  cond
  | ub.allowed || rhs != 0:
      prim.udiv(lhs, rhs)
  | ub.suppressed:
      0
  | ub.checked:
      panic()

method (lhs :: UInt(n)).$div_floor(rhs :: UInt(n)) :: UInt(n):
  lhs div_trunc rhs

method (lhs :: UInt(n)).$rem_trunc(rhs :: UInt(n)) :: UInt(n):
  cond
  | ub.allowed || rhs != 0:
      prim.urem(lhs, rhs)
  | ub.suppressed:
      0
  | ub.checked:
      panic()

method (lhs :: UInt(n)).$rem_floor(rhs :: UInt(n)) :: UInt(n):
  lhs rem_trunc rhs

method (lhs :: UInt(n)).$rem(rhs :: UInt(n)) :: UInt(n):
  lhs rem_trunc rhs

method (lhs :: UInt(n)).$eq(rhs :: UInt(n)) :: Boolean:
  prim.icmp_eq(lhs, rhs)

method (lhs :: UInt(n)).$ne(rhs :: UInt(n)) :: Boolean:
  prim.icmp_ne(lhs, rhs)

method (lhs :: UInt(n)).$lt(rhs :: UInt(n)) :: Boolean:
  prim.icmp_ult(lhs, rhs)

method (lhs :: UInt(n)).$le(rhs :: UInt(n)) :: Boolean:
  prim.icmp_ule(lhs, rhs)

method (lhs :: UInt(n)).$gt(rhs :: UInt(n)) :: Boolean:
  prim.icmp_ugt(lhs, rhs)

method (lhs :: UInt(n)).$ge(rhs :: UInt(n)) :: Boolean:
  prim.icmp_uge(lhs, rhs)

//==============================================================================
method (specl BinaryInteger as δ).cast_exact(src :: Specl(_ :: int) as σ) :: δ:
  specl.assert(σ coerces_to δ)
  src

method (specl Int(w2) as δ).cast_exact(src :: Int(w1)) :: δ:
  cond
  | w1 ≤ w2:
      src
  | ub.allowed:
      prim.trunc_nsw(src, ~to: δ)
  | ub.suppressed:
      prim.trunc(src, ~to: δ)
  | ub.checked:
      if src ≥ δ.min_value && src ≤ δ.max_value
      | prim.trunc_nsw(src, ~to: δ)
      | panic()

method (specl UInt(w2) as δ).cast_exact(src :: Int(w1)) :: δ:
  cond
  | w1 == w2:
      if ub.checked && src < 0
      | panic()
      | prim.retype(src, ~to: δ)
  | w1 < w2:
      cond
      | ub.allowed:
          prim.zext_nneg(src, ~to: δ)
      | ub.suppressed:
          prim.zext(src, ~to: δ)
      | ub.checked:
          if src < 0
          | panic()
          | prim.zext_nneg(src, ~to: δ)
  | w1 > w2:
      cond
      | ub.allowed:
          prim.trunc_nuw(src, ~to: δ)
      | ub.suppressed:
          prim.trunc(src, ~to: δ)
      | ub.checked:
          if src ≥ δ.min_value && src ≤ δ.max_value
          | prim.trunc_nuw(src, ~to: δ)
          | panic()

method (specl UInt(w2) as δ).cast_exact(src :: UInt(w1)) :: δ:
  cond
  | w1 ≤ w2:
      src
  | ub.allowed:
      prim.trunc_nuw(src, ~to: δ)
  | ub.suppressed:
      prim.trunc(src, ~to: δ)
  | ub.checked:
      if src ≤ δ.max_value
      | prim.trunc_nuw(src, ~to: δ)
      | panic()

method (specl Int(w2) as δ).cast_exact(src :: UInt(w1)) :: δ:
  cond
  | w1 < w2:
      src
  | w1 == w2:
      if ub.checked && src > δ.max_value
      | panic()
      | prim.retype(src, ~to: δ)
  | ub.allowed:
      prim.trunc_nsw(src, ~to: δ)
  | ub.suppressed:
      prim.trunc(src, ~to: δ)
  | ub.checked:
      if src ≤ δ.max_value
      | prim.trunc_nsw(src, ~to: δ)
      | panic()

//==============================================================================
method (specl BinaryInteger as δ).cast_wrap(specl src :: int) :: δ:
  prim.constant_int(δ, src)

method (specl Int(w2) as δ).cast_wrap(src :: Int(w1)) :: δ:
  if w1 ≤ w2
  | src
  | prim.trunc(src, ~to: δ)

method (specl UInt(w2) as δ).cast_wrap(src :: Int(w1)) :: δ:
  cond
  | w1 < w2:
      prim.sext(src, ~to: δ)
  | w1 == w2:
      prim.retype(src, ~to: δ)
  | w1 > w2:
      prim.trunc(src, ~to: δ)

method (specl UInt(w2) as δ).cast_wrap(src :: UInt(w1)) :: δ:
  if w1 ≤ w2
  | src
  | prim.trunc(src, ~to: δ)

method (specl Int(w2) as δ).cast_wrap(src :: UInt(w1)) :: δ:
  cond
  | w1 < w2:
      src
  | w1 == w2:
      prim.retype(src, ~to: δ)
  | w1 > w2:
      prim.trunc(src, ~to: δ)

//==============================================================================
method (rhs :: α && BinaryInteger).$not() :: α:
  prim.not(rhs)

method (lhs :: α && BinaryInteger).$and(rhs :: α) :: α:
  prim.and(lhs, rhs)

method (lhs :: α && BinaryInteger).$or(rhs :: α) :: α:
  prim.or(lhs, rhs)

method (lhs :: α && BinaryInteger).$xor(rhs :: α) :: α:
  prim.xor(lhs, rhs)
