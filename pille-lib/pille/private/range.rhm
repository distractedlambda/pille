#lang pille/private/kernel

import:
  "cond.rhm" open
  "generic_ops.rhm" open
  "iter.rhm" open
  "panic.rhm" open
  "specl_ops.rhm" open
  "type_traits.rhm" open
  "unify.rhm" open

//==============================================================================
export struct Range(α :: type):
  start :: α
  end :: α

export struct RangeFrom(α :: type):
  start :: α

export struct RangeTo(α :: type):
  end :: α

export struct RangeFull

//==============================================================================
method (rng :: Range(_)).$contains(val):
  ~transparent
  (val ≥ rng.start) ∧ (val < rng.end)

method (rng :: RangeFrom(_)).$contains(val):
  ~transparent
  val ≥ rng.start

method (rng :: RangeTo(_)).$contains(val):
  ~transparent
  val < rng.end

//==============================================================================
export struct RangeIndex(α):
  value :: α

method (lhs :: RangeIndex(α)).$lt(rhs :: RangeIndex(α)):
  ~transparent
  lhs.value < rhs.value

property (rng :: Range(Integral as α)).$start_index :: RangeIndex(α):
  .{rng.start}

property (rng :: Range(Integral as α)).$end_index :: RangeIndex(α):
  .{rng.end}

method (rng :: Range(BinaryInteger as α)).$next_index(idx :: RangeIndex(α)) :: RangeIndex(α):
  .{idx.value + 1}

method (rng :: Range(BinaryInteger as α)).$index_read(idx :: RangeIndex(α)):
  idx.value

//==============================================================================
export expr.macro
| '$lhs .. $(tl :: Sequence) $()':
    ~op_stx: op
    ~all_stx: stx
    ~order: enumeration
    match tl
    | '':
        values(
          '(make_range_from($lhs))'.relocate_span([stx]),
          '')
    | '$(rhs :: expr_meta.AfterInfixParsed('..'))':
        values(
          '(make_range($lhs, $rhs))'.relocate_span([lhs, op, rhs]),
          '$rhs.tail ...')
| '.. $(tl :: Sequence) $()':
    ~op_stx: op
    ~all_stx: stx
    ~order: enumeration
    match tl
    | '':
        values(
          '(RangeFull{})'.relocate_span([stx]),
          '')
    | '$(rhs :: expr_meta.AfterPrefixParsed('..'))':
        values(
          '(make_range_to($rhs))'.relocate_span([op, rhs]),
          '$rhs.tail ...')

fun make_range_from(start :: α) :: RangeFrom(α):
  .{start}

fun make_range(start :: α, stop :: β) :: Range(γ):
  ~where γ = unify(α, β)
  .{start, stop}

fun make_range_to(stop :: α) :: RangeTo(α):
  .{stop}
