#lang pille/private/kernel

import:
  "cond.rhm" open
  "rhm_panic.rhm" open

export expr.macro
| 'panic($msg)':
    ~all_stx: stx
    'do_panic($msg, $(stx.srcloc()))'
| 'panic':
    'do_panic'

fun do_panic
| (specl msg :: string, specl loc :: maybe(srcloc)) :: Never:
    cond
    | using_hosted_execution:
        rhombus(loc, msg):
          import rhombus/static open
          error(~exn: Panic, ~srcloc: loc, msg)
        prim.unreachable
    | ~else:
        prim.trap
| (specl msg :: string) :: Never:
    do_panic(msg, #false)
