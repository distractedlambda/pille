#lang pille/private/kernel

export specl_bind.macro 'BinaryInteger':
  'Int(_) || UInt(_)'

export specl_bind.macro 'Bitwise':
  'BinaryInteger || Boolean'

export specl_bind.macro 'Integral':
  'BinaryInteger || Specl(_ :: int)'

export specl_bind.macro 'FloatingPoint':
  'Float || Double'

export specl_bind.macro 'CoercesTo($(δ :: specl_expr_meta.Parsed))':
  'σ :: type when type_of(faux(σ) :: $δ)'

export specl_bind.macro 'CoercesFrom($σ)':
  'δ :: type when type_of(faux($σ) :: δ)'

export specl.operator (σ :: type) coerces_to (δ :: type):
  ~order: equivalence
  ~associativity: ~none
  σ matches CoercesTo(δ)
