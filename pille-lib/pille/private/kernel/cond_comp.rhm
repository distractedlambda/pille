#lang rhombus/static/and_meta

import:
  "specl_bind.rhm" open
  "specl_expr.rhm" open
  "specl_ns.rhm" open
  "expr.rhm" open
  "expr_forms.rhm" open
  "local_defn.rhm" open
  pille/concretize open

export only_space namespace:
  specl

//==============================================================================
pille_expr.macro 'specl.match $(target :: specl_expr_meta.Parsed)
                  | $(hd_bind :: specl_bind_meta.Parsed): $hd_body
                  | $(tl_bind :: specl_bind_meta.Parsed): $tl_body
                  | ...':
  let [bind, ...] = [hd_bind, tl_bind, ...]
  let [body, ...] = [hd_body, tl_body, ...]
  pille_expr_meta.pack_concretize(
    'concretize_specl_match(
       $(specl_expr_meta.unpack_rhombus_expr(target)),
       [fun(tgt):
          $(specl_bind_meta.compile(
              bind,
              'tgt',
              'fun():
                 pille_expr.concretize(
                   $(local_defn_meta.encapsulate_body(body)))')),
        ...])')

fun concretize_specl_match(target, cases :~ List):
  try ~escape_as ret:
    let exns = for List (case in cases):
      try ~escape_as continue:
        let concretize_body = try:
          case(target)
          ~catch exn :: Exn.Fail.Concretize.Recoverable:
            continue(exn)
        ret(concretize_body())
    error(
      ~exn: Exn.Fail.Concretize.Recoverable,
      "no matching case",
      error.cause(each exns),
      ...)

//==============================================================================
specl_expr.macro 'specl.assert($(test :: specl_expr_meta.Parsed))':
  specl_expr_meta.pack_rhombus_expr(
    'specl_assert(
       $(specl_expr_meta.unpack_rhombus_expr(test)),
       $(test.to_source_string()))')

pille_expr.macro 'specl.assert($test)':
  'specl(specl.assert($test))'

fun specl_assert(test, test_string):
  test || error(~exn: Exn.Fail.Concretize,
                @str{specl assertion failure: '@test_string'})
