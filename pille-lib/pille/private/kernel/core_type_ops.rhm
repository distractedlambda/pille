#lang rhombus/static/and_meta

import:
  "coerce.rhm" open
  "core_type_forms.rhm" open
  "core_types.rhm" open
  "method_call.rhm" open
  "priority.rhm" open
  "specl_annot_forms.rhm" open
  "specl_bind.rhm" open
  "specl_bind_forms.rhm" open
  "specl_expr_forms.rhm" open
  "specl_fun.rhm" open
  "specl_method.rhm" open
  "unique_member.rhm" open
  pille/concretize open
  pille/lowering

//==============================================================================
// Specialization function `$call` implementation
SpeclOverload.register(
  ~selector:
    unique_member.symbol(call),
  ~impl:
    fun(receiver, args :~ List):
      specl_bind.compile(
        _ :: function,
        receiver,
        block:
          let (arities, _, _) = Function.arity(receiver)
          guard arities bits.(?) args.length()
          | error(
              ~exn: Exn.Fail.Concretize.Recoverable,
              "wrong number of arguments in call")
          receiver(&args)))

//==============================================================================
// Tuple `$assign` implementation
Overload.register(
  ~selector:
    unique_member.symbol(assign),
  ~concretizer:
    fun(receiver_type, arg_types :~ [Type, ...]):
      guard.let receiver_type :: TupleType = receiver_type | #false
      guard.let [arg_type] = arg_types | #false
      let arg_coe = resolve_coercer(arg_type, receiver_type)
      let [slot, ...] = receiver_type.slots
      let [lower_elem_update, ...] = for List (elem_type in receiver_type.elements):
        try ~escape_as esc:
          let assign_method_concr :~ Overload.Concretized = try:
            resolve_overload(
              elem_type,
              unique_member.symbol(assign),
              [elem_type])
            ~catch _ :: Exn.Fail.Concretize.Recoverable:
              esc(fun(_, _, arg_elem_val): arg_elem_val)
          let call_low = assign_method_concr.lower_call
          match assign_method_concr.inout_mask
          | 0:
              fun(env, recv_elem_val, arg_elem_val):
                call_low(env, [recv_elem_val, arg_elem_val])
                recv_elem_val
          | 1:
              fun(env, recv_elem_val, arg_elem_val):
                let [_, new_elem_val] = call_low(env, [recv_elem_val, arg_elem_val])
                new_elem_val
          | _:
              error(
                ~exn: Exn.Fail.Concretize,
                "'$assign' method cannot take new value as 'inout'")
      Overload.Concretized(
        ~result_type:
          VoidType(),
        ~inout_mask:
          1, // CONSIDER: make non-inout if no element is?
        ~lower_call:
          fun(env, [recv_val, arg_val]):
            let arg_val = arg_coe(env, arg_val)
            [#false,
             lowering.packing.pack(
               [lower_elem_update(
                  env,
                  lowering.packing.get(recv_val, slot),
                  lowering.packing.get(arg_val, slot)),
                ...])]))

//==============================================================================
specl.property (AnyTuple as α).length:
  #%rhombus(α):
    TupleType.elements(α).length()

//==============================================================================
specl.method (AnyTuple as α).ElementAt(idx :: nat):
  #%rhombus(α, idx):
    let TupleType(element_types) = α
    guard idx < element_types.length()
    | error(
        ~exn: Exn.Fail.Concretize.Recoverable,
        "tuple element index out of bounds",
        error.val(~label: "tuple type", α),
        error.val(~label: "index", idx))
    element_types[idx]

//==============================================================================
// `$coerce_to` impl for initializer expressions
Overload.register(
  ~selector:
    unique_member.symbol(coerce_to),
  ~concretizer:
    fun(receiver_type, arg_types :~ [Type, ...]):
      guard.let InitExprType(selector, init_arg_types) = receiver_type | #false
      guard.let [SpeclType(tgt :: Type) as tgt_specl] = arg_types | #false
      let init_ovl = resolve_overload(tgt_specl, selector, init_arg_types)
      guard init_ovl.inout_mask == 0
      | error(
          ~exn: Exn.Fail.Concretize.Recoverable,
          "initializer expressions cannot supply 'inout' arguments")
      let init_res_coe = resolve_coercer(init_ovl.result_type, tgt)
      Overload.Concretized(
        ~result_type:
          tgt,
        ~lower_call:
          let [init_arg_slot, ...] = TupleType(init_arg_types).slots
          let init_ovl_low = init_ovl.lower_call
          fun(env, [recv_val, #false]):
            let init_arg_vals = [lowering.packing.get(recv_val, init_arg_slot), ...]
            let [init_res_val] = init_ovl_low(env, [#false, &init_arg_vals])
            [init_res_coe(env, init_res_val)]))
