#lang rhombus/static/and_meta

import:
  "../util/syntax.rhm" open
  "implicit.rhm" open
  "priority.rhm" open
  "specl_bind.rhm" open
  "specl_expr.rhm" open
  "specl_method_call.rhm" open
  "unique_member.rhm" open
  "when_where.rhm" open
  pille/concretize open
  rhombus/delay open

//==============================================================================
export unique_member unify_with

//==============================================================================
export fun eval_unify(
  ~srcloc: srcloc :: maybe(Srcloc) = #false,
  types :: [Type, ...],
) :: Type:
  fun eval_oneway(fst :~ Type, snd :~ Type) :~ Type:
    let res = ImplicitKey.with_empty_env(_) <| fun():
      eval_specl_method_call(fst, unique_member.symbol(unify_with), [snd])
    unless res is_a Type
    | error(
        ~srcloc,
        ~exn: Exn.Fail.Concretize,
        "result of '$unify_with' method must be a type",
        error.val(~label: "first type", fst),
        error.val(~label: "second type", snd),
        error.val(~label: "result", res))
    res

  match types
  | [fst]:
      fst
  | [fst, snd]:
      guard !(fst === snd)
      | fst
      try ~escape_as esc:
        let fwd_res = try:
          eval_oneway(fst, snd)
          ~catch fwd_exn :: Exn.Fail.Concretize.Recoverable:
            try:
              esc <| eval_oneway(snd, fst)
              ~catch rev_exn :: Exn.Fail.Concretize.Recoverable:
                error(
                  ~srcloc,
                  ~exn: Exn.Fail.Concretize.Recoverable,
                  "types cannot be unified",
                  error.vals(~label: "types", [fst, snd]),
                  error.cause(fwd_exn),
                  error.cause(rev_exn))
        let rev_res = try:
          eval_oneway(snd, fst)
          ~catch _ :: Exn.Fail.Concretize.Recoverable:
            esc(fwd_res)
        unless fwd_res === rev_res
        | error(
            ~srcloc,
            ~exn: Exn.Fail.Concretize,
            "type unification is non-commutative",
            ~details: ["changing the order of inputs types changes the result"],
            error.vals(~label: "types", [fst, snd]),
            error.val(~label: "forward result", fwd_res),
            error.val(~label: "reverse result", rev_res))
        fwd_res

  | [fst, snd, &types]:
      eval_unify(~srcloc, [eval_unify(~srcloc, [fst, snd]), &types])
