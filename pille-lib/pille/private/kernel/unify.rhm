#lang rhombus/static/and_meta

import:
  "../util/syntax.rhm" open
  "priority.rhm" open
  "specl_bind.rhm" open
  "specl_expr.rhm" open
  "when_where.rhm" open
  pille/concretize open
  rhombus/delay open

meta:
  syntax_class Spec:
    kind: ~group
    fields:
      fst_type
      snd_type
      [ww, ...]
      priority_expr
      body
  | '($(fst_type :: specl_bind_meta.Parsed),
      $(snd_type :: specl_bind_meta.Parsed)): $(oab :: OptionsAndBody)':
      def ([ww_opt, ...], [other_opt, ...]):
        [oab.option, ...].partition((_ matches '$('~when' || '~where') $_ ...'))
      match_def '$(ww :: WhenWhereOption); ...':
        '$ww_opt; ...'
      match_def '$(group_option_sequence
                   | '~priority $(block_or_tail priority :: IdentifierName)':
                       field priority_expr = 'priority.reflect($priority)'
                       default priority_expr = 'Priority.new_automatic()')':
        '$other_opt; ...'
      match_def '$(body :: Group)' = oab.body

export defn.macro 'unify $(spec :: Spec)':
  ~all_stx: stx
  'UnifyRule.register(
     ~srcloc:
       $(stx.srcloc()),
     ~priority:
       $spec.priority_expr,
     ~eval:
       fun(fst_type, snd_type):
         $(specl_bind_meta.compile(
             specl_bind_meta.pack_conjunction(
               [specl_bind_meta.pack_parallel_bindings(
                  [spec.fst_type, spec.snd_type]),
                spec.ww, ...]),
             '[fst_type, snd_type]',
             specl_expr_meta.as_rhombus_expr(spec.body))))'
