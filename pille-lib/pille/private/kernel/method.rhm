#lang rhombus/static/and_meta

import:
  "../util/assert.rhm" open
  "../util/syntax.rhm" open
  "coerce.rhm" open
  "specl_bind_forms.rhm" open
  "specl_expr.rhm" open
  "core_type_forms.rhm" open
  "expr_forms.rhm" open
  "implicit.rhm" open
  "local_defn.rhm" open
  "local_defn_forms.rhm" open
  "special_name.rhm" open
  "when_where.rhm" open
  pille/concretize open:
    rename method as concretize_method
  pille/llvm
  pille/lowering
  rhombus/delay open
  rhombus/syntax_map open

//==============================================================================
space.transform _method_priority:
  space_path pille/method_priority
  bridge_definer bridge
  meta_namespace _method_priority_meta:
    reflection space
    description "method priority"

//==============================================================================
export namespace method

alias 'method.priority':
  ~only_space space
  '_method_priority'

namespace method.priority

//==============================================================================
defn.macro 'def_fallback_priority':
  let id = syntax_meta.flip_introduce('fallback')
  let refl_id = Syntax.make_temp_id(id, ~keep_name: #true)
  'def $refl_id:
     concretize_method.Priority(
       ~name: "fallback",
       ~lower_than: Set.by(===){},
       ~higher_than: Set.by(===){})

   _method_priority.bridge $id:
     ['$refl_id', [], []]'

export def_fallback_priority

//==============================================================================
meta:
  syntax_class PriorityClause:
    kind: ~group
    fields: [lower_than, ...] [higher_than, ...]
  | '~lower_than $(other :: IdentifierName)':
      field [lower_than, ...] = [other]
      field [higher_than, ...] = []
  | '~lower_than: $(others :: IdentifierName); ...':
      field [lower_than, ...] = [others, ...]
      field [higher_than, ...] = []
  | '~higher_than $(other :: IdentifierName)':
      field [lower_than, ...] = []
      field [higher_than, ...] = [other]
  | '~higher_than: $(others :: IdentifierName); ...':
      field [lower_than, ...] = []
      field [higher_than, ...] = [others, ...]

  syntax_class PriorityClauses:
    kind: ~sequence
    fields: [lower_than, ...] [higher_than, ...]
  | ': $(clause :: PriorityClause); ...':
      field [lower_than, ...] = [clause.lower_than, ..., ...]
      field [higher_than, ...] = ['fallback', clause.higher_than, ..., ...]
  | '':
      field [lower_than, ...] = []
      field [higher_than, ...] = ['fallback']

defn.macro 'method.priority $(name :: IdentifierName) $(clauses :: PriorityClauses)':
  ~all_stx: stx

  let refl_id = Syntax.make_temp_id(name.name_to_symbol(), ~keep_name: #true)

  let [[lt_refl_id, [lt_lt_refl_id, ...], _], ...]:
    [syntax_meta.value(clauses.lower_than, _method_priority_meta.space), ...]
  let all_lt_refl_id:
    Set.by(equal_binding){
      lt_refl_id, ...,
      lt_lt_refl_id, ..., ...}

  let [[ht_refl_id, _, [ht_ht_refl_id, ...]], ...]:
    [syntax_meta.value(clauses.higher_than, _method_priority_meta.space), ...]
  let all_ht_refl_id:
    Set.by(equal_binding){
      ht_refl_id, ...,
      ht_ht_refl_id, ..., ...}

  let conflicting_refl_ids = all_lt_refl_id.intersect(all_ht_refl_id)
  unless conflicting_refl_ids matches Set.empty
  | let example = Syntax.unwrap(conflicting_refl_ids.to_list(#true).first)
    syntax_meta.error(
      @str{order contradiction;
            priority would be both lower and higher than '@example'},
      stx)

  let tracked_refl_id:
    syntax_meta.track_origin(
      refl_id,
      ~add:
        [syntax_meta.flip_introduce(
           each [clauses.lower_than, ...,
                 clauses.higher_than, ...]),
         ...],
      ~space:
        _method_priority_meta.space)

  'def $tracked_refl_id:
     concretize_method.Priority(
       ~name: $(to_string(name.name_to_symbol())),
       ~lower_than: Set.by(===){$(each all_lt_refl_id), ...},
       ~higher_than: Set.by(===){$(each all_ht_refl_id), ...})

   _method_priority.bridge $name:
     ['$refl_id',
      ['$(syntax_meta.flip_introduce(each all_lt_refl_id))', ...],
      ['$(syntax_meta.flip_introduce(each all_ht_refl_id))', ...]]'

//==============================================================================
expr.macro 'method.priority.reflect($(priority :: IdentifierName))':
  let [refl_id, _, _] = syntax_meta.value(priority, _method_priority_meta.space)
  syntax_meta.track_origin(
    syntax_meta.flip_introduce(refl_id),
    ~add: syntax_meta.flip_introduce(priority),
    ~space: _method_priority_meta.space)

//==============================================================================
export fun make_automatic_method_priority():
  concretize_method.Priority(
    ~name: "automatic",
    ~lower_than: Set.by(===){},
    ~higher_than: Set.by(===){method.priority.reflect(fallback)})

//==============================================================================
export defn.macro 'method ($receiver) $(member :: pille_expr_meta.DotMemberName) $tail ...':
  ~all_stx: stx
  '#%method(
     $(stx.srcloc()),
     $member.symbol_expr,
     make_method_symbol_name_formatter($(member.to_source_string()))) \
   ($receiver) $tail ...'

fun make_method_symbol_name_formatter(dot_member_str :: String):
  fun(receiver_type, arg_types :~ List):
    @str{@receiver_type@(«dot_member_str»)(@(String.join(arg_types.map(to_string), ", ")))}

//==============================================================================
export defn.macro
| 'property ($receiver) $(member :: pille_expr_meta.DotMemberName) \
   $(op :: pille_expr_meta.AssignOp) ($arg) $tail ...':
    ~all_stx: stx
    '#%method(
       $(stx.srcloc()),
       $(syntax_meta.track_origin(
           '(concretize_method.WriteSelector($member.symbol_expr))',
           ~add: syntax_meta.flip_introduce(op),
           ~space: pille_expr_meta.space)),
       make_property_write_symbol_name_formatter($(member.to_source_string()))) \
     ($receiver) ($arg) $tail ...'

| 'property ($receiver) $(member :: pille_expr_meta.DotMemberName) $tail ...':
    ~all_stx: stx
    '#%method(
       $(stx.srcloc()),
       concretize_method.ReadSelector($member.symbol_expr),
       make_property_read_symbol_name_formatter($(member.to_source_string()))) \
     ($receiver) () $tail ...'

fun make_property_read_symbol_name_formatter(dot_member_str :: String):
  fun(receiver_type, []):
    to_string(receiver_type) ++ dot_member_str

fun make_property_write_symbol_name_formatter(dot_member_str :: String):
  fun(receiver_type, [arg_type]):
    @str{@receiver_type@dot_member_str := @arg_type}

//==============================================================================
export defn.macro 'coercion \
                   $('($_)' && receiver) \
                   $(annot_op :: pille_expr_meta.AnnotOp) \
                   $(dst_type :: SimpleNonemptySequence):
                     $(options_and_body :: Block)':
  ~all_stx: stx
  let dst_type = specl_bind_meta.encapsulate(dst_type)
  '#%method(
     $(stx.srcloc()),
     special_name.symbol(coerce_to),
     make_method_symbol_name_formatter("$coerce_to")) \
   $receiver (specl $dst_type && α) $annot_op α $options_and_body'

//==============================================================================
meta:
  syntax_class MaybeImplicitAlias:
    kind: ~sequence
    fields: name :~ maybe(Identifier)
  | '~as $(name :: Identifier)'
  | '': field name = #false

  syntax_class MaybeTypeBind:
    kind: ~sequence
    fields: normalized
    root_swap: normalized sequence
  | '$(annot_op :: pille_expr_meta.AnnotOp) $(tl :: NonemptySequence)':
      field normalized:
        syntax_meta.track_origin(
          specl_bind_meta.encapsulate(tl),
          ~add: syntax_meta.flip_introduce(annot_op),
          ~space: pille_expr_meta.space)
  | '':
      field normalized = '_'

  syntax_class MaybeInout:
    kind: ~sequence
    fields:
      [op, ...]
      present :~ Boolean
  | '$(inout_op :: pille_expr_meta.InoutOp)':
      field [op, ...] = [inout_op]
      field present = #true
  | '':
      field [op, ...] = []
      field present = #false

  syntax_class Arg:
    kind: ~group
    fields:
      is_inout :~ Boolean
      implicit_key :~ maybe(Syntax.matched_of(implicit_meta.ResolveKey))
      name :~ maybe(Identifier)
      type_bind :~ Term

  | '$(using_op :: pille_expr_meta.UsingOp) \
     $(implicit_key :: implicit_meta.ResolveKey) \
     $(maybe_alias :: MaybeImplicitAlias) \
     $(type_bind_ :: MaybeTypeBind)':
      field is_inout = #false
      field name = maybe_alias.name
      field type_bind:
        syntax_meta.track_origin(
          type_bind_,
          syntax_meta.flip_introduce(using_op),
          ~space: pille_expr_meta.space)

  | '$(specl_op :: pille_expr_meta.SpeclOp) \
     $(specl_bind :: specl_bind_meta.Parsed)':
      field is_inout = #false
      field implicit_key = #false
      field name = #false
      field type_bind:
        syntax_meta.track_origin(
          '(Specl($specl_bind))'.relocate(specl_bind),
          syntax_meta.flip_introduce(specl_op),
          ~space: pille_expr_meta.space)

  | '$(maybe_inout :: MaybeInout) \
     $(name :: Identifier) \
     $(type_bind_ :: MaybeTypeBind)':
      field is_inout = maybe_inout.present
      field implicit_key = #false
      field type_bind:
        syntax_meta.track_origin(
          type_bind_,
          [syntax_meta.flip_introduce(maybe_inout.op), ...],
          ~space: pille_expr_meta.space)

  syntax_class MaybeResType:
    kind: ~sequence
    fields:
      rhombus_expr :~ maybe(Term)
  | '$(annot_op :: pille_expr_meta.AnnotOp) $(type :: SimpleNonemptySequence)':
      field rhombus_expr:
        syntax_meta.track_origin(
          specl_expr_meta.as_rhombus_expr(type),
          ~add: syntax_meta.flip_introduce(annot_op),
          ~space: pille_expr_meta.space)
  | '':
      field rhombus_expr = #false

  syntax_class MaybeSrcloc:
    kind: ~term
  | '$slc':
      match_when slc.unwrap() is_a maybe(Srcloc)

  syntax_class Impl:
    kind: ~multi
    fields:
      [ww_opt, ...]
      transparent :~ Boolean
      srcloc :~ maybe(Srcloc)
      priority
      body
  | '$(_ :: OptionsAndBody: open)':
      def ([ww_opt_, ...], [other_opt, ...]):
        [option, ...].partition(_) <| fun(opt):
          opt matches '$('~when' || '~where') $_ ...'
      field [ww_opt, ...] = [ww_opt_, ...]
      match_def '$(group_option_sequence
                   | '~transparent':
                       field transparent = #true
                   | '~srcloc $(block_or_tail srcloc_ :: MaybeSrcloc)':
                       field srcloc = srcloc_.unwrap()
                       default srcloc = #false
                   | '~priority $(block_or_tail priority :: IdentifierName)')':
        '$other_opt; ...'

defn.macro '#%method($outer_srcloc, $selector, $symbol_name_formatter) \
            ($(receiver :: Arg)) \
            ($(arg :: Arg), ...) \
            $(res_type :: MaybeResType) \
            : $(_ :: Impl: open)':
  when receiver.implicit_key
  | syntax_meta.error("receiver cannot be implicit", receiver)

  fun make_arg_name_sym(arg :~ Syntax.matched_of(Arg)):
    guard arg.name | Symbol.uninterned_from_string("_")
    name_to_uninterned_symbol(arg.name)

  fun bind_arg_ref(arg :~ Syntax.matched_of(Arg), name_sym, type_expr):
    guard arg.name | ''
    let ref_concr_id = Syntax.make_temp_id(arg.name)
    let ref_concretizer:
      if arg.is_inout
      | 'concretize_var_ref'
      | 'concretize_let_ref'
    '«let $ref_concr_id = $(ref_concretizer)(#'$name_sym, $type_expr)
      pille_expr.macro '($arg.name)':
        '$(pille_expr_meta.pack_concretize(ref_concr_id))'»'

  let receiver_name_sym = make_arg_name_sym(receiver)
  let [arg_name_sym, ...] = [make_arg_name_sym(arg), ...]

  'define_method(
     $(srcloc || outer_srcloc),
     $selector,
     $(if priority
       | 'method.priority.reflect($priority)'
       | 'make_automatic_method_priority()'),
     $symbol_name_formatter,
     #'$receiver_name_sym,
     $receiver.is_inout,
     [#'$arg_name_sym, ...],
     [$(!arg.implicit_key), ...],
     [$arg.is_inout, ...],
     $transparent,
     fun(callsite_implicit_env, formal_types :~ List):
       $(recur roll(
           to_bind :~ [[Syntax.matched_of(Arg), Symbol], ...]:
             [[receiver, receiver_name_sym], [arg, arg_name_sym], ...],
           implicit_value_ids :~ [Identifier, ...] = [],
           formal_idx :~ Nat = 0,
         ):
           match to_bind
           | [[hd, hd_name_sym], &tl]:
               match hd.implicit_key
               | ik!!:
                   let key_id = Syntax.make_temp_id(#'key)
                   let value_id = Syntax.make_temp_id(#'value)
                   let value_type_id = Syntax.make_temp_id(#'value_type)
                   let ref_concr_id = Syntax.make_temp_id(#'ref_concr)
                   let inner = roll(tl, implicit_value_ids ++ [value_id], formal_idx)
                   'block:
                      let $key_id = $ik.rhombus_expr
                      let $value_id = ImplicitKey.resolve_value($key_id, callsite_implicit_env)
                      let $value_type_id = Expr.type($value_id)
                      let $ref_concr_id = concretize_let_ref(#'$hd_name_sym, $value_type_id)
                      specl_bind.compile(
                        $hd.type_bind,
                        $value_type_id,
                        ImplicitKey.with_value(
                          $key_id,
                          $ref_concr_id,
                          fun():
                            $(if hd.name
                              | '«pille_expr.macro '($hd.name)':
                                    '$(pille_expr_meta.pack_concretize(ref_concr_id))'»'
                              | '')
                            $inner))'
               | #false:
                   let inner = roll(tl, implicit_value_ids, formal_idx + 1)
                   'specl_bind.compile(
                      $hd.type_bind,
                      formal_types[$formal_idx],
                      block:
                        $(bind_arg_ref(hd, hd_name_sym, 'formal_types[$formal_idx]'))
                        $inner)'
           | []:
               'compile_ww(
                  [$ww_opt, ...],
                  prepare_concretize_body(
                    [$(each implicit_value_ids), ...],
                    $(if res_type.rhombus_expr
                      | 'check_result_type($(res_type.rhombus_expr), $(res_type.srcloc()))'
                      | '#false'),
                    fun(): pille_expr.concretize($(local_defn_meta.encapsulate_body(body)))))'))'

// HACK
expr.macro
| 'compile_ww([], $body)':
    body
| 'compile_ww([$(opt :: WhenWhereOption), ...], $body)':
    specl_bind_meta.compile(
      specl_bind_meta.pack_conjunction([opt, ...]),
      '#void',
      body)

fun check_result_type(val, srcloc):
  unless val is_a Type
  | error(
      ~srcloc,
      ~exn: Exn.Fail.Concretize.Recoverable,
      "result-type expression did not yield a type",
      error.val(val))
  val

fun prepare_concretize_body(implicits, res_type, concr_body):
  let concr_body:
    if res_type
    | fun():
        let body = concr_body()
        let body_low = Expr.lower_rvalue(body)
        let coe = resolve_coercer(Expr.type(body), res_type)
        Expr.Rvalue(
          ~type: res_type,
          ~lower: fun(env): coe(env, body_low(env)))
    | concr_body
  let body_implicit_env = ImplicitKey.snapshot_env()
  let concr_body = fun(): ImplicitKey.with_env(body_implicit_env, concr_body)
  values(implicits, res_type, concr_body)

// TODO: This is terrifying, fragile, and may already be wrong in subtle and unknown ways
//       It needs to be rewritten
fun define_method(
  srcloc,
  selector,
  priority,
  format_symbol_name,
  receiver_name_sym :~ Symbol,
  receiver_is_inout,
  [arg_name_sym, ...],
  [arg_is_formal, ...],
  [arg_is_inout, ...],
  is_transparent,
  match_signature :~ Function.assume_of((Map, [Type, ...]) -> values([Expr, ...], maybe(Type), () -> Expr)),
):
  let num_formal_args:
    math.sum(if arg_is_formal | 1 | 0, ...)

  let with_implicit_env:
    if is_transparent
    | fun(thunk): thunk()
    | ImplicitKey.with_empty_env

  let cached:
    let mutable cache = caches.keyed.init()
    fun(key, f):
      caches.keyed.get_or_compute(
        ~get_cache: fun(): cache,
        ~set_cache: (cache := _),
        key,
        f)

  let raw_inout_mask:
    for fold(mask = 0):
      each:
        is_inout in [receiver_is_inout, arg_is_inout, ...]
        idx in 0..
      if is_inout
      | mask bits.or (1 bits.(<<) idx)
      | mask

  let (method_inout_mask, _):
    for fold(mask = 0, idx = 0):
      each:
        is_inout in [receiver_is_inout, arg_is_inout, ...]
        is_formal in [#true, arg_is_formal, ...]
      keep_when is_formal
      values(
        if is_inout
        | mask bits.or (1 bits.(<<) idx)
        | mask,
        idx + 1)

  concretize_method.define(
    concretize_method.Defn(
      ~srcloc,
      ~selector,
      ~priority,
      ~concretizer:
        fun(receiver_type :~ Type, formal_arg_types :~ [Type, ...]):
          let callsite_implicit_env = ImplicitKey.snapshot_env()

          guard formal_arg_types.length() == num_formal_args
          | #false

          let (
            implicit_vals :~ [Expr, ...],
            res_type :~ maybe(Type),
            concretize_body :~ Function.assume_of(() -> Expr),
          ):
            with_implicit_env(_) <| fun():
              match_signature(callsite_implicit_env, [receiver_type, &formal_arg_types])

          let implicit_lows = [(each implicit_vals).lower_rvalue, ...]

          let arg_types :~ [Type, ...]:
            let mutable formal_idx = 0
            let mutable implicit_idx = 0
            for List (is_formal in [arg_is_formal, ...]):
              if is_formal
              | let ty = formal_arg_types[formal_idx]
                formal_idx := formal_idx + 1
                ty
              | let ty = implicit_vals[implicit_idx].type
                implicit_idx := implicit_idx + 1
                ty

          let raw_sig:
            [[receiver_name_sym, receiver_type.repr],
             [arg_name_sym, (each arg_types).repr], ...]

          let [res_type, raw_call_low] = cond
          | is_transparent:
              let body = concretize_body()
              let body_low = body.lower_rvalue
              [body.type,
               fun(env, raw_arg_vals :~ List):
                 let builder = lowering.builder()
                 let env = for fold(env :~ Map = env):
                   each:
                     incoming_val in raw_arg_vals
                     [name_sym, repr] in raw_sig
                     raw_idx in 0..
                   skip_when repr is_a Repr.Erased
                   let env_val = cond
                   | raw_inout_mask bits.(?) raw_idx:
                       lowering.name(incoming_val, @str{@(name_sym).in})
                       let alloca:
                         let cur_bb = builder.insertion_block!!
                         builder.position_at_start(cur_bb.parent!!.basic_blocks.first!!)
                         let alloca = builder.create_alloca(repr.llvm_type(builder.context))
                         builder.position_at_end(cur_bb)
                         alloca
                       lowering.name(alloca, @str{@(name_sym).alloca})
                       builder.create_store(incoming_val, alloca)
                       alloca
                   | ~else:
                       lowering.name(incoming_val, name_sym)
                       incoming_val
                   env ++ {name_sym: env_val}
                 let res = body_low(env)
                 let out_vals:
                   for List ([name_sym, repr] in raw_sig, raw_idx in 0..):
                     keep_when raw_inout_mask bits.(?) raw_idx
                     guard repr is_a Repr.Sized | #false
                     let alloca = env[name_sym]
                     assert(alloca is_a llvm.AllocaInst)
                     let out_val = builder.create_load(repr.llvm_type(builder.context), alloca)
                     lowering.name(out_val, @str{@(name_sym).out})
                     out_val
                 [res, &out_vals]]

          | ~else:
              cached([receiver_type, arg_types], _) <| fun(_):
                let symbol_name:
                  format_symbol_name(receiver_type, arg_types)

                let [res_type, internal_call_low] = match res_type
                | res_type!!:
                    [res_type,
                     lowering.create_internal_function(
                       symbol_name,
                       res_type.repr,
                       raw_sig,
                       ~inout_mask: raw_inout_mask,
                       fun(): concretize_body().lower_rvalue)]
                | #false:
                    let body = concretize_body()
                    [body.type,
                     lowering.create_internal_function(
                       symbol_name,
                       body.type.repr,
                       raw_sig,
                       ~inout_mask: raw_inout_mask,
                       fun(): body.lower_rvalue)]

                [res_type,
                 fun(env, raw_arg_vals):
                   internal_call_low(raw_arg_vals)]

          concretize_method.Concretized(
            ~result_type: res_type,
            ~inout_mask: method_inout_mask,
            ~lower_call:
               fun(env, explicit_vals :~ List):
                 raw_call_low(
                   env,
                   block:
                     let mutable explicit_idx = 0
                     let mutable implicit_idx = 0
                     for List (is_explicit in [#true, arg_is_formal, ...]):
                       if is_explicit
                       | let val = explicit_vals[explicit_idx]
                         explicit_idx := explicit_idx + 1
                         val
                       | let val = implicit_lows[implicit_idx](env)
                         implicit_idx := implicit_idx + 1
                         val))))
