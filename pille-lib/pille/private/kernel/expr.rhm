#lang rhombus/static/and_meta

import:
  "specl_expr.rhm" open
  "core_types.rhm" open
  pille/concretize open

meta import:
  "../util/annot.rhm" open

export:
  pille_expr
  meta:
    pille_expr_meta

space.enforest pille_expr:
  space_path pille/expr
  macro_definer macro
  meta_namespace pille_expr_meta:
    reflection space
    description "expression"
    operator_description "operator"

    parse_syntax_class Parsed
    parse_prefix_more_syntax_class AfterPrefixParsed
    parse_infix_more_syntax_class AfterInfixParsed

    name_start_syntax_class NameStart
    bound_name_start_syntax_class BoundNameStart

    identifier_parser parse_name
    dotted_identifier_parser parse_name

    fun parse_name(nm):
      guard.let '$(_ :: specl_expr_meta.BoundNameStart)' = nm
      | syntax_meta.error("not bound as an expression", nm)
      pack_concretize('concretize_specl(specl_expr.eval($nm))')

    private parsed_packer _pack
    private parsed_unpacker _unpack

    fun is_packed(stx):
      _unpack(stx, fun(_): #false)

    export annot.def Packed:
      Term && satisfying(is_packed)

    export fun pack_concretize(rhm_expr :: Group) :~ Packed:
      _pack(expr_meta.pack_expr(rhm_expr)).relocate_span([rhm_expr])

    export fun unpack_concretize(packed :: Packed) :~ Term:
      _unpack(packed)

    export fun pack_expr(stx :: Group) :~ Packed:
      guard stx !is_a Packed | stx
      pack_concretize('pille_expr.concretize($stx)').relocate_span([stx])

    export fun pack_specl_rhombus_expr(rhm_expr :: Group) :~ Packed:
      pack_concretize('concretize_specl($rhm_expr)').relocate_span([rhm_expr])

    export fun pack_specl_expr(spexp :: specl_expr_meta.Packed) :~ Packed:
      spexp
        |> specl_expr_meta.unpack_rhombus_expr
        |> pack_specl_rhombus_expr

  export:
    concretize

  expr.macro 'concretize($(pexp :: pille_expr_meta.Parsed))':
    pille_expr_meta.unpack_concretize(pexp)

fun concretize_specl(val):
  Expr.Rvalue(
    ~type: SpeclType(val),
    ~lower: fun(_): #false)
