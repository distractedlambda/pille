#lang rhombus/static/and_meta

import:
  "../runtime/compiler.rhm" open
  "../runtime/ub_policy.rhm" open
  "specl_def.rhm" open
  "specl_expr_forms.rhm" open

export namespace ub

specl.def ub.checked:
  #%rhombus:
    Compiler.require_current().ub_policy matches UbPolicy.check

specl.def ub.suppressed:
  #%rhombus:
    Compiler.require_current().ub_policy matches UbPolicy.suppress

specl.def ub.allowed:
  #%rhombus:
    Compiler.require_current().ub_policy matches UbPolicy.allow
