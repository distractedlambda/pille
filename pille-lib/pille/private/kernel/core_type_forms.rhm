#lang rhombus/static/and_meta

import:
  "core_types.rhm" open
  "expr.rhm" open
  "expr_forms.rhm" open
  "prim.rhm"
  "specl_annot_forms.rhm" open
  "specl_bind.rhm" open
  "specl_bind_forms.rhm" open
  "specl_def.rhm" open
  "specl_expr.rhm" open
  "specl_expr_forms.rhm" open
  "specl_fun.rhm" open
  "unique_member.rhm" open
  pille/concretize open

//==============================================================================
export specl.def Void:
  #%rhombus:
    VoidType()

//==============================================================================
export specl.def Never:
  #%rhombus:
    NeverType()

//==============================================================================
export specl.def Boolean:
  #%rhombus:
    BooleanType()

//==============================================================================
export specl.fun Int(width :: pos_int):
  #%rhombus(width):
    IntType(width)

export specl_bind.macro 'Int($(width :: specl_bind_meta.Parsed))':
  specl_bind_meta.pack_decomposition('int_extractor', [width])

fun int_extractor(target):
  guard.let IntType(width) = target
  | error(
      ~exn: Exn.Fail.Concretize.Recoverable,
      "binding requires an Int type",
      error.val(~label: "target", target))
  width

//==============================================================================
export specl.fun UInt(width :: pos_int):
  #%rhombus(width):
    UIntType(width)

export specl_bind.macro 'UInt($(width :: specl_bind_meta.Parsed))':
  specl_bind_meta.pack_decomposition('uint_extractor', [width])

fun uint_extractor(target):
  guard.let UIntType(width) = target
  | error(
      ~exn: Exn.Fail.Concretize.Recoverable,
      "binding requires a UInt type",
      error.val(~label: "target", target))
  width

//==============================================================================
export specl.def Float:
  #%rhombus:
    FloatType()

//==============================================================================
export specl.def Double:
  #%rhombus:
    DoubleType()

//==============================================================================
export specl.fun Specl(value):
  #%rhombus(value):
    SpeclType(value)

export specl_bind.macro 'Specl($(value :: specl_bind_meta.Parsed))':
  specl_bind_meta.pack_decomposition('specl_extractor', [value])

fun specl_extractor(target):
  guard.let SpeclType(value) = target
  | error(
      ~exn: Exn.Fail.Concretize.Recoverable,
      "binding requires a Specl type",
      error.val(~label: "target", target))
  value

//==============================================================================
export specl.def Tuple:
  #%rhombus:
    fun(&elements):
      ~name: Tuple
      for (elem in elements):
        unless elem is_a Type // HACK
        | error(
            ~exn: Exn.Fail.Concretize.Recoverable,
            error.annot_msg(),
            error.val(elem),
            error.annot("type"))
      TupleType(elements)

export specl_bind.macro 'Tuple($(element :: specl_bind_meta.Parsed), ...)':
  specl_bind_meta.pack_decomposition(
    'make_tuple_extractor($(Function.count(element, ...)))',
    [element, ...])

fun make_tuple_extractor(length):
  fun(target):
    guard.let TupleType(elements when elements.length() == length) = target
    | error(
        ~exn: Exn.Fail.Concretize.Recoverable,
        @str{binding requires a Tuple type with @length elements},
        error.val(~label: "target", target))
    values(&elements)

//==============================================================================
export specl_bind.macro 'AnyTuple':
  specl_bind_meta.pack_decomposition('any_tuple_extractor')

fun any_tuple_extractor(target):
  guard.let TupleType(_) = target
  | error(
      ~exn: Exn.Fail.Concretize.Recoverable,
      "binding requires a Tuple type",
      error.val(~label: "target", target))
  values()

//==============================================================================
export specl.fun Simd(element :: type, length :: pos_int):
  #%rhombus(element, length):
    SimdType(element, length)

export specl_bind.macro 'Simd($(element :: specl_bind_meta.Parsed),
                              $(length :: specl_bind_meta.Parsed))':
  specl_bind_meta.pack_decomposition('simd_extractor', [element, length])

fun simd_extractor(target):
  guard.let SimdType(element, length) = target
  | error(
      ~exn: Exn.Fail.Concretize.Recoverable,
      "binding requires a Simd type",
      error.val(~label: "target", target))
  values(element, length)

//==============================================================================
export specl.def RawPtr:
  #%rhombus:
    RawPtrType()

//==============================================================================
export specl_expr.macro
| '«InitExpr'$(dmn :: pille_expr_meta.DotMemberName)($(arg :: specl_expr_meta.ParsedAs('type')), ...)'»':
    specl_expr_meta.pack_rhombus_expr(
      'InitExprType(
         $dmn.symbol_expr,
         [$(specl_expr_meta.unpack_rhombus_expr(arg)), ...])')

| '«InitExpr'$(dmn :: pille_expr_meta.DotMemberName)'»':
    specl_expr_meta.pack_rhombus_expr(
      'InitExprType(
         ReadSelector($dmn.symbol_expr),
         [])')

| '«InitExpr'$(_ :: pille_expr_meta.DotOp)($(arg :: specl_expr_meta.ParsedAs('type')), ...)'»':
    specl_expr_meta.pack_rhombus_expr(
      'InitExprType(
         unique_member.symbol(call),
         [$(specl_expr_meta.unpack_rhombus_expr(arg)), ...])')

| '«InitExpr'$(_ :: pille_expr_meta.DotOp){$(arg :: specl_expr_meta.ParsedAs('type')), ...}'»':
    specl_expr_meta.pack_rhombus_expr(
      'InitExprType(
         unique_member.symbol(new),
         [$(specl_expr_meta.unpack_rhombus_expr(arg)), ...])')

//==============================================================================
export pille_expr.macro '«InitExpr'$sig'»':
  'specl(InitExpr'$sig')'

//==============================================================================
export specl_bind.macro
| '«InitExpr'$(_ :: specl_bind_meta.Wildcard)'»':
    specl_bind_meta.pack_decomposition('any_init_expr_extractor')

| '«InitExpr'$(dmn :: pille_expr_meta.DotMemberName)($(arg :: specl_bind_meta.Parsed), ...)'»':
    specl_bind_meta.pack_decomposition(
      'make_init_expr_extractor(
         $dmn.symbol_expr,
         $(Function.count(arg, ...)))',
      [arg, ...])

| '«InitExpr'$(dmn :: pille_expr_meta.DotMemberName)'»':
    specl_bind_meta.pack_decomposition(
      'make_init_expr_extractor(
         ReadSelector($dmn.symbol_expr),
         0)')

| '«InitExpr'$(_ :: pille_expr_meta.DotOp)($(arg :: specl_bind_meta.Parsed), ...)'»':
    specl_bind_meta.pack_decomposition(
      'make_init_expr_extractor(
         unique_member.symbol(call),
         $(Function.count(arg, ...)))',
      [arg, ...])

| '«InitExpr'$(_ :: pille_expr_meta.DotOp){$(arg :: specl_bind_meta.Parsed), ...}'»':
    specl_bind_meta.pack_decomposition(
      'make_init_expr_extractor(
         unique_member.symbol(new),
         $(Function.count(arg, ...)))',
      [arg, ...])

fun any_init_expr_extractor(target):
  guard.let InitExprType(_, _) = target
  | error(
      ~exn: Exn.Fail.Concretize.Recoverable,
      "binding requires an InitExpr type",
      error.val(~label: "target", target))
  values()

fun make_init_expr_extractor(selector, arity :~ Nat):
  fun(target):
    guard.let InitExprType(tgt_selector, tgt_args) = target
    | error(
        ~exn: Exn.Fail.Concretize.Recoverable,
        "binding requires an InitExpr type",
        error.val(~label: "target", target))

    unless selector == tgt_selector
    | let sel_desc = match selector
      | ReadSelector(sym):
          "." ++ to_string(sym)
      | unique_member.symbol(call):
          ".(...)"
      | unique_member.symbol(new):
          ".{...}"
      | sym :: Symbol:
          "." ++ to_string(sym) ++ "(...)"
      error(
        ~exn: Exn.Fail.Concretize.Recoverable,
        @str{binding requires an InitExpr(@sel_desc) type},
        error.val(~label: "target", target))

    unless arity == tgt_args.length()
    | error(
        ~exn: Exn.Fail.Concretize.Recoverable,
        @str{binding requires an InitExpr type of arity @arity},
        error.val(~label: "target", target))

    values(&tgt_args)
