#lang rhombus/static/and_meta

import:
  "specl_annot.rhm" open
  "specl_annot_forms.rhm" open
  "specl_bind.rhm" open
  "specl_expr.rhm" open
  "specl_expr_forms.rhm" open
  "when_where.rhm"
  pille/concretize open

//==============================================================================
meta:
  import:
    rhombus/static/meta open

  export:
    only_space namespace:
      specl_bind_meta

  fun specl_bind_meta.encapsulate(stx :: Group) :: Term:
    '($stx)'.relocate_span([stx])

  syntax_class specl_bind_meta.Wildcard:
    kind: ~sequence
  | '$(bound_as specl_bind_meta.space: '_')'

  syntax_class specl_bind_meta.AnnotOp:
    kind: ~sequence
  | '$(bound_as specl_bind_meta.space: '::')'

//==============================================================================
export specl_bind.macro '_':
  specl_bind_meta.pack_decomposition('wildcard')

fun wildcard(_):
  values()

//==============================================================================
export specl_bind.macro '#%parens($child)':
  child

//==============================================================================
export specl_bind.macro '#%literal $(value :: specl_expr_meta.Literal)':
  specl_bind_meta.pack_equal_to('#%literal $value')

//==============================================================================
export specl_bind.macro '$lhs :: $(rhs :: specl_annot_meta.AfterInfixParsed('::')) $()':
  ~weaker_than: ~other
  ~associativity: ~none
  ~op_stx: op
  ~all_stx: stx
  values(
    specl_bind_meta
      .pack_decomposition(
        'make_annot_extractor(
           $(specl_annot_meta.unpack_rhombus_predicate(rhs)),
           $(stx.srcloc()),
           $(rhs.to_source_string()))',
        [lhs])
      .relocate_span([lhs, op, rhs]),
    '$rhs.tail ...')

fun make_annot_extractor(pred, srcloc, annot_str):
  fun(target):
    unless pred(target)
    | error(
        ~srcloc,
        ~exn: Exn.Fail.Concretize.Recoverable,
        error.annot_msg("target"),
        error.val(~label: "target", target),
        error.annot(annot_str))
    target

//==============================================================================
export specl_bind.macro '$lhs && $rhs':
  ~order: logical_conjunction
  specl_bind_meta.pack_conjunction([lhs, rhs])

//==============================================================================
export specl_bind.macro '$lhs || $rhs':
  ~order: logical_disjunction
  specl_bind_meta.pack_disjunction([lhs, rhs])

//==============================================================================
export specl_bind.macro
| '$lhs as $(id :: Identifier)':
    ~order: logical_conjunction
    specl_bind_meta.pack_conjunction([lhs, specl_bind_meta.pack_metavariable(id)])
| 'as':
    ~op_stx: op
    specl_bind_meta.pack_metavariable(op)

//==============================================================================
export specl_bind.macro '$lhs when $(rhs :: Group) $()':
  specl_bind_meta.pack_conjunction(
    [lhs,
     specl_bind_meta.pack_side_condition(
       specl_expr_meta.as_rhombus_expr(
         rhs))])

//==============================================================================
export specl_bind.macro
| '$lhs where: $(hd :: when_where.WhereBinding); $(tl :: when_where.WhereBinding); ...':
    specl_bind_meta.pack_conjunction([lhs, hd, tl, ...])
| '$lhs where $tail ...':
    ~op_stx: op
    '$lhs $op: $tail ...'

//==============================================================================
export specl_bind.macro 'equal_to($spexp)':
  specl_bind_meta.pack_equal_to(
    specl_expr_meta.as_rhombus_expr(
      spexp))
