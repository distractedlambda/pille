#lang rhombus/static/and_meta

meta import:
  "../util/annot.rhm" open

export:
  specl_expr
  meta:
    specl_expr_meta

//==============================================================================
space.enforest specl_expr:
  space_path pille/specl_expr
  macro_definer macro
  meta_namespace specl_expr_meta:
    export:
      Literal
      Packed
      as_rhombus_expr
      pack_rhombus_expr
      pack_specl_expr
      parse
      unpack_rhombus_expr

    reflection space
    description "specl expression"
    operator_description "specl operator"

    parse_syntax_class Parsed
    parse_prefix_more_syntax_class AfterPrefixParsed
    parse_infix_more_syntax_class AfterInfixParsed

    name_start_syntax_class NameStart
    bound_name_start_syntax_class BoundNameStart

    private parsed_packer _pack
    private parsed_unpacker _unpack

    fun is_packed(stx):
      _unpack(stx, fun(_): #false)

    annot.def Packed:
      Term && satisfying(is_packed)

    fun pack_rhombus_expr(rhm_expr :: Group) :~ Packed:
      _pack(expr_meta.pack_expr(rhm_expr))
        .relocate_span([rhm_expr])

    fun pack_specl_expr(spexp :: Group) :~ Packed:
      pack_rhombus_expr('specl_expr.eval($spexp)')
        .relocate_span([spexp])

    fun unpack_rhombus_expr(packed :: Packed) :~ Term:
      _unpack(packed)

    fun as_rhombus_expr(spexp :: Group) :~ Term:
      expr_meta
        .pack_expr('specl_expr.eval($spexp)')
        .relocate_span([spexp])

    fun parse('$(parsed :: Parsed)') :~ Packed:
      parsed

    syntax_class Literal:
      kind: ~term
    | '$(_ :: Number)'
    | '$(_ :: Boolean)'
    | '$(_ :: String)'

  export:
    eval

  expr.macro 'eval($(spexp :: specl_expr_meta.Parsed))':
    specl_expr_meta.unpack_rhombus_expr(spexp)
