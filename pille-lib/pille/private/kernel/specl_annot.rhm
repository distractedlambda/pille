#lang rhombus/static/and_meta

import:
  "../runtime/compiler.rhm" open

export:
  specl_annot
  meta: specl_annot_meta

//==============================================================================
space.enforest specl_annot:
  space_path pille/specl_annot
  macro_definer macro
  meta_namespace specl_annot_meta:
    export:
      Packed
      pack_rhombus_predicate
      parse
      unpack_rhombus_predicate

    reflection space
    description "specl annotation"
    operator_description "specl annotation operator"

    parse_syntax_class Parsed
    parse_prefix_more_syntax_class AfterPrefixParsed
    parse_infix_more_syntax_class AfterInfixParsed

    name_start_syntax_class NameStart
    bound_name_start_syntax_class BoundNameStart

    private parsed_packer _pack
    private parsed_unpacker _unpack

    fun is_packed(stx):
      _unpack(stx, fun(_): #false)

    annot Packed:
      Term && satisfying(is_packed)

    fun pack_rhombus_predicate(pred_expr :: Group) :~ Packed:
      _pack(expr_meta.pack_expr(pred_expr)).relocate_span([pred_expr])

    fun unpack_rhombus_predicate(packed :: Packed) :~ Term:
      _unpack(packed)

    fun parse('$(parsed :: Parsed)') :~ Packed:
      parsed

  export:
    predicate

  expr.macro 'predicate($(ann :: specl_annot_meta.Parsed))':
    specl_annot_meta.unpack_rhombus_predicate(ann)

//==============================================================================
export defn.macro 'specl_annot $(name :: IdentifierName): $(ann :: Group)':
  let key = Symbol.gen(name.name_to_symbol())
  '«fun force_predicate():
      Compiler
        .require_current()
        .get_or_init_attr(
          #'$key,
          fun(): specl_annot.predicate($ann))

    specl_annot.macro '($name)':
      '$(specl_annot_meta.pack_rhombus_predicate(
           'force_predicate()'))'»'
