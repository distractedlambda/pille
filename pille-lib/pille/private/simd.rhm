#lang pille/private/kernel

import:
  "cond.rhm" open
  "generic_ops.rhm" open
  "int.rhm" open
  "misc.rhm" open
  "panic.rhm" open
  "pointer.rhm" open
  "specl_ops.rhm" open
  "type_traits.rhm" open
  "unify.rhm" open

//==============================================================================
coercion (elem :: Simd.Scalar as α) :: Simd(β, n):
  ~when α coerces_to β
  prim.splat(elem :: β, n)

unify(α :: Simd.Scalar, Simd(β, n)):
  Simd(unify(α, β), n)

//==============================================================================
coercion (src :: Simd(UInt(ws), n)) :: Simd(UInt(wd), n) as δ:
  ~when ws < wd
  prim.zext(src, ~to: δ)

unify(Simd(UInt(w1), n), Simd(UInt(w2), n)):
  Simd(UInt(max(w1, w2)), n)

//==============================================================================
coercion (src :: Simd(UInt(ws), n)) :: Simd(Int(wd), n) as δ:
  ~when ws < wd
  prim.zext(src, ~to: δ)

unify(Simd(UInt(w1), n), Simd(Int(w2), n)):
  Simd(Int(max(w1 + 1, w2)), n)

//==============================================================================
coercion (src :: Simd(Int(ws), n)) :: Simd(Int(wd), n) as δ:
  ~when ws < wd
  prim.sext(src, ~to: δ)

unify(Simd(Int(w1), n), Simd(Int(w2), n)):
  Simd(Int(max(w1, w2)), n)

//==============================================================================
coercion (src :: Simd(Float, n)) :: Simd(Double, n) as δ:
  prim.fpext(src, ~to: δ)

unify(Simd(Float, n), Simd(Double, n)):
  Simd(Double, n)

//==============================================================================
coercion (src :: Simd(UInt(w), n)) :: Simd(Float, n) as δ:
  ~when w ≤ 24
  prim.uitofp(src, ~to: δ)

unify(Simd(UInt(w), n), Simd(Float, n)):
  ~when w ≤ 24
  Simd(Float, n)

//==============================================================================
coercion (src :: Simd(Int(w), n)) :: Simd(Float, n) as δ:
  ~when w ≤ 24
  prim.sitofp(src, ~to: δ)

unify(Simd(Int(w), n), Simd(Float, n)):
  ~when w ≤ 24
  Simd(Float, n)

//==============================================================================
coercion (src :: Simd(UInt(w), n)) :: Simd(Double, n) as δ:
  ~when w ≤ 53
  prim.uitofp(src, ~to: δ)

unify(Simd(UInt(w), n), Simd(Double, n)):
  ~when w ≤ 53
  Simd(Double, n)

//==============================================================================
coercion (src :: Simd(Int(w), n)) :: Simd(Double, n) as δ:
  ~when w ≤ 53
  prim.sitofp(src, ~to: δ)

unify(Simd(Int(w), n), Simd(Double, n)):
  ~when w ≤ 53
  Simd(Double, n)

//==============================================================================
property (specl Simd(BinaryInteger as ι, n) as σ).iota :: σ:
  ~when n - 1 ≤ ι.max_value
  prim.iota(σ)

//==============================================================================
method (rhs :: Simd(Bitwise, _) as σ).$not() :: σ:
  prim.not(rhs)

//==============================================================================
global_defn.macro 'bitwise_binops:
                     $(member_name :: Group): $prim_name
                     ...':
  'method (lhs :: Simd(Bitwise, _) as σ). $member_name (rhs :: σ) :: σ:
     prim. $prim_name(lhs, rhs)
   ...'

bitwise_binops:
  $and: and
  $or: or
  $xor: xor

//==============================================================================
global_defn.macro 'bitwise_reduceops:
                     $(member_name :: Group): $prim_name
                     ...':
  'method (smd :: Simd(Bitwise as α, _)). $member_name() :: α:
     prim. $prim_name(smd)
   ...'

bitwise_reduceops:
  reduce_and: reduce_and
  reduce_or: reduce_or
  reduce_xor: reduce_xor

//==============================================================================
global_defn.macro 'boolean_reduceops:
                     $(member_name :: Group): $other_name
                     ...':
  'method (smd :: Simd(Boolean, _)). $member_name() :: Boolean:
     smd. $other_name()
   ...'

boolean_reduceops:
  all: reduce_and
  any: reduce_or
  parity: reduce_xor

//==============================================================================
global_defn.macro 'int_overflow_binops:
                     ($type_name,
                      $member_name,
                      $nowrap_prim_name,
                      $wrap_prim_name,
                      $overflow_prim_name)
                     ...':
  'method (lhs :: Simd($type_name(_), _) as σ). $member_name(rhs :: σ) :: σ:
     cond
     | ub.allowed:
         prim. $nowrap_prim_name(lhs, rhs)
     | ub.suppressed:
         prim. $wrap_prim_name(lhs, rhs)
     | ub.checked:
         let res = prim. $overflow_prim_name(lhs, rhs)
         if res[1].any()
         | panic()
         | res[0]
   ...'

int_overflow_binops:
  (Int, $add, add_nsw, add, sadd_with_overflow)
  (Int, $sub, sub_nsw, sub, ssub_with_overflow)
  (Int, $mul, mul_nsw, mul, smul_with_overflow)
  (UInt, $add, add_nuw, add, uadd_with_overflow)
  (UInt, $sub, sub_nuw, sub, usub_with_overflow)
  (UInt, $mul, mul_nuw, mul, umul_with_overflow)

//==============================================================================
method (rhs :: Simd(BinaryInteger, _) as σ).$neg() :: σ:
  0 - rhs

method (rhs :: Simd(BinaryInteger, _) as σ).$neg_wrap() :: σ:
  0 -% rhs

//==============================================================================
global_defn.macro 'int_wrap_binops:
                     ($member_name, $prim_name)
                     ...':
  'method (lhs :: Simd(BinaryInteger, _) as σ). $member_name(rhs :: σ) :: σ:
     prim. $prim_name(lhs, rhs)
   ...'

int_wrap_binops:
  ($add_wrap, add)
  ($sub_wrap, sub)
  ($mul_wrap, mul)

//==============================================================================
global_defn.macro 'float_binops:
                     ($member_name, $prim_name)
                     ...':
  'method (lhs :: Simd(FloatingPoint, _) as σ). $member_name(rhs :: σ) :: σ:
     prim. $prim_name(lhs, rhs)
   ...'

float_binops:
  ($add, fadd)
  ($sub, fsub)
  ($mul, fmul)
  ($div, fdiv)
  ($rem_trunc, frem)
  ($pow, pow)

//==============================================================================
global_defn.macro 'float_unops:
                     ($member_name, $prim_name)
                     ...':
  'method (x :: Simd(FloatingPoint, _) as σ). $member_name() :: σ:
     prim. $prim_name(x)
   ...'

float_unops:
  ($abs, fabs)
  ($acos, acos)
  ($asin, asin)
  ($ceil, ceil)
  ($cos, cos)
  ($exp, exp)
  ($floor, floor)
  ($neg, fneg)
  ($round, roundeven)
  ($sin, sin)
  ($sqrt, sqrt)
  ($tan, tan)
  ($trunc, ftrunc)

//==============================================================================
method (ptrs :: Simd(RawPtr, n) as φ).$add_wrap(offsets :: Simd(BinaryInteger, n)) :: φ:
  let offsets = Simd(NativeInt, n).cast_wrap(offsets)
  prim.ptradd(ptrs, offsets)

method (ptrs :: Simd(PtrTo(α), n) as φ).$add_wrap(offsets :: Simd(BinaryInteger, n)) :: φ:
  let offsets = Simd(NativeInt, n).cast_wrap(offsets)
  let offsets = offsets *% α.byte_stride
  prim.ptradd(ptrs, offsets)

//==============================================================================
global_defn.macro 'compareops:
                     ($elem_type, $member_name, $prim_name)
                     ...':
  'method (lhs :: Simd(α, n)). $member_name(rhs :: Simd(α, n)) :: Simd(Boolean, n):
     ~where $elem_type = α
     prim. $prim_name(lhs, rhs)
   ...'

compareops:
  (BinaryInteger || RawPtr || PtrTo(_), $eq, icmp_eq)
  (BinaryInteger || RawPtr || PtrTo(_), $ne, icmp_ne)
  (UInt(_) || RawPtr || PtrTo(_), $lt, icmp_ult)
  (UInt(_) || RawPtr || PtrTo(_), $gt, icmp_ugt)
  (UInt(_) || RawPtr || PtrTo(_), $le, icmp_ule)
  (UInt(_) || RawPtr || PtrTo(_), $ge, icmp_uge)
  (Int(_), $lt, icmp_slt)
  (Int(_), $gt, icmp_sgt)
  (Int(_), $le, icmp_sle)
  (Int(_), $ge, icmp_sge)
  (FloatingPoint, $eq, fcmp_oeq)
  (FloatingPoint, $ne, fcmp_one)
  (FloatingPoint, $lt, fcmp_olt)
  (FloatingPoint, $le, fcmp_ole)
  (FloatingPoint, $gt, fcmp_ogt)
  (FloatingPoint, $ge, fcmp_oge)

//==============================================================================
method (tst :: Simd(Boolean, n)).select(thn :: α, els :: β) :: γ:
  ~where γ && Simd(_, n) = unify(α, β)
  prim.select(tst, thn :: γ, els :: γ)
