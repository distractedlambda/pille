#lang pille/private/kernel

import:
  "type_traits.rhm" open

method (tup :: AnyTuple as τ).$index_read(specl idx :: nat) :: τ.ElementAt(idx):
  prim.tuple_get(tup, idx)

method (inout tup :: AnyTuple as τ).$index_write(
  specl idx :: nat,
  elem :: CoercesTo(τ.ElementAt(idx)),
) :: Void:
  tup := prim.tuple_set(tup, idx, elem :: τ.ElementAt(idx))
