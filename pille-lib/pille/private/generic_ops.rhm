#lang pille/private/kernel

import:
  "type_traits.rhm" open
  "unify.rhm" open

//==============================================================================
global_defn.macro 'generic_funops:
                     $name($hd_arg_id, $tl_arg_id, ...)
                     ...':
  'unique_member $name
   ...

   specl.fun $name($hd_arg_id, $tl_arg_id, ...):
     $hd_arg_id.$ $name($tl_arg_id, ...)
   ...

   fun $name($hd_arg_id, $tl_arg_id, ...):
     ~transparent
     $hd_arg_id.$ $name($tl_arg_id, ...)
   ...'

export generic_funops:
  abs(x)
  acos(x)
  asin(x)
  ceil(x)
  cos(x)
  exp(x)
  floor(x)
  round(x)
  sin(x)
  sqrt(x)
  tan(x)
  trunc(x)

//==============================================================================
global_defn.macro 'generic_binops:
                     $op $order $name $(term_option_sequence
                                        | '~no_specl': field no_specl = #true)
                     ...':
  'unique_member $name
   ...

   operator
   | lhs $op rhs:
       ~order: $order
       ~transparent
       lhs.$ $name(rhs)
   | (lhs :: α) $op (rhs :: β):
       ~where γ = unify(α, β)
       ~transparent
       (lhs :: γ).$ $name(rhs :: γ)
   ...

   $(if no_specl
     | ''
     | 'specl.operator lhs $op rhs:
          ~order: $order
          lhs.$ $name(rhs)')
   ...'

export generic_binops:
  + addition add
  +% addition add_wrap ~no_specl
  * multiplication mul
  *% multiplication mul_wrap ~no_specl
  / multiplication div
  div_trunc multiplication div_trunc
  div_floor multiplication div_floor
  div_ceil multiplication div_ceil
  % multiplication rem
  rem_trunc multiplication rem_trunc
  rem_floor multiplication rem_floor
  rem_ceil multiplication rem_ceil
  ** exponentiation pow
  ∧ bitwise_conjunction and
  ∨ bitwise_disjunction or
  ⊻ bitwise_disjunction xor
  == equivalence eq ~no_specl
  != equivalence ne ~no_specl
  < order_comparison lt
  > order_comparison gt
  <= order_comparison le
  >= order_comparison ge

//==============================================================================
global_defn.macro 'generic_binpreops:
                     $op $prefix_order $infix_order $prefix_name $infix_name \
                       $(term_option_sequence
                         | '~no_specl': field no_specl = #true)
                     ...':
  'unique_member $prefix_name
   ...

   unique_member $infix_name
   ...

   operator
   | $op rhs:
       ~order: $prefix_order
       ~transparent
       rhs.$ $prefix_name()
   | lhs $op rhs:
       ~order: $infix_order
       ~transparent
       lhs.$ $infix_name(rhs)
   | (lhs :: α) $op (rhs :: β):
       ~where γ = unify(α, β)
       ~transparent
       (lhs :: γ).$ $infix_name(rhs :: γ)
   ...

   $(if no_specl
     | ''
     | 'specl.operator
        | $op rhs:
            ~order: $prefix_order
            rhs.$ $prefix_name()
        | lhs $op rhs:
            ~order: $infix_order
            lhs.$ $infix_name(rhs)')
   ...'

export generic_binpreops:
  - multiplication addition neg sub
  -% multiplication addition neg_wrap sub_wrap ~no_specl

//==============================================================================
export operator
| ! (specl b :: boolean) :: Specl(!b):
    ~order: logical_negation
    specl(!b)
| ! (rhs :: CoercesTo(Boolean)) :: Boolean:
    prim.not(rhs :: Boolean)

export specl.operator !rhs:
  ~order: logical_negation
  #%rhombus(rhs):
    import rhombus/static open
    !rhs

//==============================================================================
export unique_member not

export operator ¬rhs:
  ~order: bitwise_negation
  ~transparent
  rhs.$not()

export specl.operator ¬rhs:
  ~order: bitwise_negation
  rhs.$not()

//==============================================================================
export operator (lhs :: α) === (rhs :: β):
  ~where γ = unify(α, β)
  prim.repr_equivalent(lhs :: γ, rhs :: γ)

export operator lhs !== rhs:
  !(lhs === rhs)

//==============================================================================
export unique_member contains

export operator lhs in rhs:
  ~order: equivalence
  ~transparent
  rhs.$contains(lhs)

export operator lhs ∉ rhs:
  ~order: equivalence
  ~transparent
  ¬(lhs in rhs)

//==============================================================================
export only_space expr specl_expr:
  rename:
    ¬ as not
    ∧ as and
    ∨ as or
    ⊻ as xor
    != as ≠
    <= as ≤
    >= as ≥
    in as ∈
