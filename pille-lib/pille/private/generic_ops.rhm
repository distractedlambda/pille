#lang pille/private/kernel

import:
  "specl_ops.rhm" open
  "type_traits.rhm" open

//==============================================================================
global_defn.macro 'generic_binops:
                     $op $order $name
                     ...':
  'unique_member $name
   ...

   operator
   | lhs $op rhs:
       ~order: $order
       ~transparent
       lhs.$ $name(rhs)
   | (lhs :: α) $op (rhs :: β):
       ~where γ = unify(α, β)
       ~transparent
       (lhs :: γ).$ $name(rhs :: γ)
   ...'

export generic_binops:
  + addition add
  +% addition add_wrap
  * multiplication mul
  *% multiplication mul_wrap
  / multiplication div
  div_trunc multiplication div_trunc
  div_floor multiplication div_floor
  div_ceil multiplication div_ceil
  % multiplication rem
  rem_trunc multiplication rem_trunc
  rem_floor multiplication rem_floor
  rem_ceil multiplication rem_ceil
  ∧ bitwise_conjunction and
  ∨ bitwise_disjunction or
  ⊻ bitwise_disjunction xor
  == equivalence eq
  != equivalence ne
  < order_comparison lt
  > order_comparison gt
  <= order_comparison le
  >= order_comparison ge

//==============================================================================
global_defn.macro 'generic_binpreops:
                     $op $prefix_order $infix_order $prefix_name $infix_name
                     ...':
  'unique_member $prefix_name
   ...

   unique_member $infix_name
   ...

   operator
   | $op rhs:
       ~order: $prefix_order
       ~transparent
       rhs.$ $prefix_name()
   | lhs $op rhs:
       ~order: $infix_order
       ~transparent
       lhs.$ $infix_name(rhs)
   | (lhs :: α) $op (rhs :: β):
       ~where γ = unify(α, β)
       ~transparent
       (lhs :: γ).$ $infix_name(rhs :: γ)
   ...'

export generic_binpreops:
  - multiplication addition neg sub
  -% multiplication addition neg_wrap sub_wrap

//==============================================================================
export operator
| ! (specl b :: boolean) :: Specl(!b):
    ~order: logical_negation
    specl(!b)
| ! (rhs :: CoercesTo(Boolean)) :: Boolean:
    prim.not(rhs :: Boolean)

//==============================================================================
export unique_member not

export operator ¬rhs:
  ~order: bitwise_negation
  ~transparent
  rhs.$not()

//==============================================================================
export struct CastExact(α :: type):
  src :: α

method (src :: α).cast_exact():
  CastExact(α){src}

//==============================================================================
export struct CastWrap(α :: type):
  src :: α

method (src :: α).cast_wrap():
  CastWrap(α){src}

//==============================================================================
export operator (lhs :: α) === (rhs :: β):
  ~where γ = unify(α, β)
  prim.repr_equivalent(lhs :: γ, rhs :: γ)

export operator lhs !== rhs:
  !(lhs === rhs)

//==============================================================================
export unique_member contains

export operator lhs in rhs:
  ~order: equivalence
  ~transparent
  rhs.$contains(lhs)

//==============================================================================
export only_space expr:
  rename:
    ¬ as not
    ∧ as and
    ∨ as or
    ⊻ as xor
    != as ≠
    <= as ≤
    >= as ≥
    in as ∈
