#lang rhombus/static/and_meta

import:
  "../util/equatable_by_identity.rhm" open
  "priority.rhm" open
  "type_fwd.rhm" open

export UnifyRule
class UnifyRule(
  srcloc :~ maybe(Srcloc),
  priority :~ Priority,
  eval :~ Function.assume_of((_Type, _Type) -> maybe(_Type)),
):
  internal _UnifyRule

  equatable_by_identity

  constructor ~error

  export:
    Table
    register
    snapshot_table

  annot.def Table:
    [UnifyRule, ...]

  Parameter.def current_table :~ Table:
    []

  fun register(
    ~srcloc: srcloc :: maybe(Srcloc) = #false,
    ~priority: priority :: Priority = Priority.new_automatic(),
    ~eval: eval :: (_Type, _Type) -> maybe(_Type),
  ) :: Void:
    let tbl = current_table()
    current_table(List.cons(_UnifyRule(srcloc, priority, eval), tbl))

  fun snapshot_table() :~ Table:
    current_table().sort(_) <| fun(fst :~ UnifyRule, snd :~ UnifyRule):
      fst.priority.is_higher_than(snd.priority)
