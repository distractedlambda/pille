#lang rhombus/static/and_meta

import:
  "../util/equatable_by_identity.rhm" open

export Priority
class Priority(
  ~name: name :: String,
  ~lower_than: lower_than :: Set.of(Priority),
  ~higher_than: higher_than :: Set.of(Priority),
):
  ~name: concretize.method.Priority

  internal _Priority

  equatable_by_identity

  // `higher_than` holds every priority reachable by following
  // `~higher_than` links down from this one, and `lower_than` does the same
  // for `~lower_than` links going up. A chain can switch from one kind of
  // link to the other, as in `high ~higher_than low` together with
  // `lowest ~lower_than low`. So this priority is also higher when some
  // priority is below it and above `other` at the same time.
  method is_higher_than(other :: _Priority) :~ Boolean:
    (other in higher_than
       || this in other.lower_than
       || (for any (middle in higher_than): middle in other.lower_than))

def Priority.fallback:
  Priority(
    ~name: "fallback",
    ~lower_than: Set.by(===){},
    ~higher_than: Set.by(===){})

fun Priority.new_automatic() :~ Priority:
  Priority(
    ~name: "automatic",
    ~lower_than: Set.by(===){},
    ~higher_than: Set.by(===){Priority.fallback})
