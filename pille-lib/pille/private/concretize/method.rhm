#lang rhombus/static/and_meta

import:
  "../util/equatable_by_identity.rhm" open
  "priority.rhm" open
  "type_fwd.rhm" open
  pille/llvm

//============================================================================
export class ReadSelector(property :: Symbol)

export class WriteSelector(property :: Symbol)

//============================================================================
annot.delayed_declare _Concretizer

export MethodDefn
class MethodDefn(
  srcloc :~ maybe(Srcloc),
  selector :~ Any,
  priority :~ Priority,
  concretizer :~ _Concretizer,
):
  internal _MethodDefn

  equatable_by_identity

  constructor ~error

  export:
    Concretized
    Concretizer
    Table
    register
    snapshot_table

  class Concretized(
    ~result_type:
      result_type :: _Type,
    ~inout_mask:
      inout_mask :: Nat = 0,
    ~lower_call:
      lower_call :: (
        env :: Map,
        explicit_vals :: [maybe(llvm.Value), ...],
      ) -> [maybe(llvm.Value), maybe(llvm.Value), ...])

  annot.def Concretizer:
    (receiver_type :: _Type, arg_types :: [_Type, ...]) -> maybe(Concretized)

  annot.def Table:
    Map.of(Any, [MethodDefn, ...])

  Parameter.def current_table :~ Table:
    Map{}

  fun register(
    ~srcloc: srcloc :: maybe(Srcloc) = #false,
    ~selector: selector :: Any,
    ~priority: priority :: Priority = Priority.new_automatic(),
    ~concretizer: concretizer :: Concretizer,
  ) :: Void:
    let tbl = current_table()
    current_table(
      tbl ++ {
        selector:
          List.cons(
            _MethodDefn(srcloc, selector, priority, concretizer),
            tbl.maybe[selector] || [])})

  fun snapshot_table() :~ Table:
    for Map ((sel, defns) in current_table()):
      let defns = defns.sort(_) <| fun(fst :~ MethodDefn, snd :~ MethodDefn):
        fst.priority.is_higher_than(snd.priority)
      values(sel, defns)

annot.delayed_complete _Concretizer:
  Function.assume_of(
    (receiver_type :: _Type, arg_types :: [_Type, ...])
      -> maybe(MethodDefn.Concretized))
