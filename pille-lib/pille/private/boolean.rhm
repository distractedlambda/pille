#lang pille/private/kernel

import:
  "generic_ops.rhm" open
  "specl_ops.rhm" open
  "unify.rhm" open

//==============================================================================
coercion (specl value :: boolean) :: Boolean:
  prim.constant_int(Boolean, if value | 1 | 0)

//==============================================================================
unify(Specl(_ :: boolean), Specl(_ :: boolean)):
  Boolean

//==============================================================================
unify(Specl(_ :: boolean), Boolean):
  Boolean

//==============================================================================
method (test :: Boolean).select(then :: τ, else :: ε) :: α:
  ~where α = unify(τ, ε)
  prim.select(test, then :: α, else :: α)
