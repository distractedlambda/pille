#lang rhombus/static/and_meta

module only_pille_spaces ~lang pille:
  export:
    only_space specl_annot specl_bind specl_expr expr labeled_expr local_defn priority unique_member:
      all_from(pille)

import:
  "private/runtime/jit_linker.rhm" open
  "private/runtime/compiler.rhm" open
  "private/runtime/rhombus_interop.rhm" open
  "private/util/defer.rhm" open
  "private/util/syntax.rhm" open
  "private/kernel/local_defn_forms.rhm":
    expose:
      concretize_let_ref
  pille/concretize open
  pille/llvm
  pille/lowering
  rhombus/delay open
  self!only_pille_spaces open

export:
  all_from(self!only_pille_spaces)

//==============================================================================
module global_jit ~lang rhombus/static:
  import:
    "private/runtime/jit_linker.rhm" open
    "private/runtime/compiler.rhm" open
    "private/runtime/ub_policy.rhm" open
    "private/util/defer.rhm" open
    pille/llvm
    rhombus/thread open

  def lock = Semaphore(1)
  def mutable global_linker :~ maybe(JitLinker) = #false

  fun make_linker(ub_policy):
    JitLinker(
      Compiler(
        ~code_gen_opt_level: llvm.CodeGenOptLevel.aggressive,
        ~code_model: llvm.CodeModel.jit_default,
        ~ub_policy,
        ~using_hosted_execution: #true))

  export fun configure_jit(
    ~ub_policy:
      ub_policy :: UbPolicy:
        UbPolicy.from_env.force(),
  ) :~ Void:
    lock.wait()
    defer lock.post()
    global_linker := make_linker(ub_policy)
    #void

  export fun with_jit_linker(thunk :~ Function.assume_of(JitLinker -> ~any)) :~ Any.like_result(thunk):
    lock.wait()
    defer lock.post()
    let linker = global_linker || block:
      let linker = make_linker(UbPolicy.from_env.force())
      global_linker := linker
      linker
    thunk(linker)

import self!global_jit open

//==============================================================================
module pille_ext ~lang rhombus/static:
  import:
    pille open
    parent!global_jit open
    "private/runtime/ub_policy.rhm" open

  export:
    all_from(pille)
    configure_jit
    UbPolicy

import self!pille_ext as pille

export:
  pille
  only_space namespace:
    pille.specl

//==============================================================================
meta:
  syntax_class SpeclLetArg:
    kind: ~group
    fields: binding init
  | '$(_ :: pille.local_defn_meta.SpeclLetOp) \
     $(_ :: pille.local_defn_meta.SpeclBindingSpec: open)'

  syntax_class SpeclArg:
    kind: ~group
    fields: binding init
  | '$(_ :: pille.expr_meta.SpeclOp) \
     $(binding :: NonemptySequence) \
     $(bound_as expr_meta.space: '=') \
     $(init :: expr_meta.Parsed)'

  | '$(_ :: pille.expr_meta.SpeclOp) \
     $(binding :: Identifier)':
      match_def '$(init :: expr_meta.Parsed)' = binding

  def type_specl_annot:
    pille.specl_annot_meta.parse('type')

  syntax_class DynArg:
    kind: ~group
    fields: name type init
  | '$(name :: Identifier) \
     $(ao :: pille.expr_meta.AnnotOp) \
     $(type_ :: NonemptySequence) \
     $('$(bound_as expr_meta.space: '=')' && eo) \
     $(init_ :: expr_meta.Parsed)':
      field type = type_
        |> pille.specl_expr_meta.pack_specl_expr
        |> pille.specl_expr_meta.pack_implicitly_annotated(_, type_specl_annot)
      field init = init_
        |> syntax_meta.track_origin(
             _,
             ~add: syntax_meta.flip_introduce(ao),
             ~space: pille.expr_meta.space)
        |> syntax_meta.track_origin(
             _,
             ~add: syntax_meta.flip_introduce(eo))

  | '$(name :: Identifier) \
     $(ao :: pille.expr_meta.AnnotOp) \
     $(type_ :: Group)':
      field type = type_
        |> pille.specl_expr_meta.pack_specl_expr
        |> pille.specl_expr_meta.pack_implicitly_annotated(_, type_specl_annot)
      match_def '$(init_ :: expr_meta.Parsed)' = name
      field init:
        syntax_meta.track_origin(
          init_,
          ~add: syntax_meta.flip_introduce(ao),
          ~space: pille.expr_meta.space)

  syntax_class MaybeArgs:
    kind: ~sequence
  | '($arg, ...)'
  | '': field [arg, ...] = []

export expr.macro 'pille $(_ :: MaybeArgs: open): $body':
  let [dyn_arg_syms, specl_arg_inits, dyn_arg_inits, stub_body]:
    recur process_args(
      args = [arg, ...],
      dyn_arg_type_ids = [],
      specl_arg_idx = 0,
    ):
      match args
      | ['$(arg :: SpeclLetArg)', &args]:
          let [dyn_arg_syms, specl_arg_inits, dyn_arg_inits, stub_body]:
            process_args(args, dyn_arg_type_ids, specl_arg_idx)
          [dyn_arg_syms,
           specl_arg_inits,
           dyn_arg_inits,
           'pille.specl_bind.compile(
              $arg.binding,
              pille.specl_expr.eval($arg.init),
              $stub_body)']

      | ['$(arg :: SpeclArg)', &args]:
          let [dyn_arg_syms, specl_arg_inits, dyn_arg_inits, stub_body]:
            process_args(args, dyn_arg_type_ids, specl_arg_idx + 1)
          [dyn_arg_syms,
           [arg.init, &specl_arg_inits],
           dyn_arg_inits,
           'pille.specl_bind.compile(
              $arg.binding,
              specl_arg_vals[$specl_arg_idx],
              $stub_body)']

      | ['$(arg :: DynArg)', &args]:
          let sym = name_to_uninterned_symbol(arg.name)
          let type_id = Syntax.make_temp_id(arg.name)
          let ref_id = Syntax.make_temp_id(arg.name)
          let [dyn_arg_syms, specl_arg_inits, dyn_arg_inits, stub_body]:
            process_args(args, [&dyn_arg_type_ids, type_id], specl_arg_idx)
          [[sym, &dyn_arg_syms],
           specl_arg_inits,
           [arg.init, &dyn_arg_inits],
           '«block:
               let $type_id = $(pille.specl_expr_meta.unpack_rhombus_expr(arg.type))
               let $ref_id = concretize_let_ref(#'$sym, $type_id)
               pille.expr.macro '($arg.name)': '$(pille.expr_meta.pack_concretize(ref_id))'
               $stub_body»']

      | []:
          [[], [], [],
           '[[$(each dyn_arg_type_ids), ...],
             pille.expr.concretize_body: $body]']

  let stub = syntax_meta.lift_expr_to_before(
    'make_stub(
       [#'$(each dyn_arg_syms), ...],
       fun(specl_arg_vals :~ List): $stub_body)')

  '$stub([$(each specl_arg_inits), ...], [$(each dyn_arg_inits), ...])'

fun make_stub(
  dyn_arg_syms :: [Symbol, ...],
  concretize :: ([Any, ...]) -> [[Type, ...], Expr],
):
  let cache_attr_key = Symbol.gen("hosted_cache")

  fun compile_specialization(specl_args :: List) :: Function:
    with_jit_linker(_) <| fun(linker :~ JitLinker):
      let cache = linker.compiler.get_or_init_attr(cache_attr_key, MutableMap)
      cache.get(specl_args, _) <| fun():
        let callout = parameterize { Compiler.current: linker.compiler }:
          let [dyn_arg_types, body] = concretize(specl_args)

          let RhombusToPilleAdapter(make_callout, read_args, write_result):
            RhombusToPilleAdapter(
              [[each dyn_arg_syms, each dyn_arg_types], ...],
              body.type)

          let native_sym:
            let suffix:
              match specl_args
              | []: ""
              | [arg, ...]: "{" ++ String.join([to_string(arg), ...], ", ") ++ "}"
            linker.compiler.gen_native_symbol("pille" ++ suffix)

          let body_low = body.lower_rvalue

          linker.compiler.define_function(
            native_sym,

            fun(llvm_ctx):
              llvm.FunctionType(llvm.VoidType(llvm_ctx), [llvm.PointerType(llvm_ctx)]),

            fun(llvm_fn :: llvm.Function):
              let builder = llvm.Builder(llvm_fn.context)
              defer builder.dispose()

              llvm_fn.call_conv := llvm.CallConv.c

              let frame_ptr = llvm_fn.arguments.first!!
              lowering.name(frame_ptr, "frame")

              let entry_bb = llvm_fn.basic_blocks.add("entry")
              builder.position_at_end(entry_bb)

              lowering.with_builder(builder, _) <| fun():
                fun terminated(): #void
                fun unterminated(_): builder.create_ret_void()
                lowering.handle_termination(~terminated, ~unterminated, _) <| fun():
                  let [arg_val, ...] = read_args(frame_ptr)
                  let res_val = body_low(Map{each dyn_arg_syms: arg_val, ...})
                  write_result(frame_ptr, res_val)
                  #void)

          linker.compiler.force_deferred_concretization()

          let fptr = linker.function_pointer(native_sym)
          let callout = make_callout(fptr)

          fun(args):
            ~name: pille
            try:
              callout(&args)
              ~finally:
                // Keep the linker from being collected for as long as this function
                // might be called
                Function.black_box(linker)

        cache[specl_args] := callout
        callout

  fun(specl_args, dyn_args):
    compile_specialization(specl_args)(dyn_args)
